# Form kontak. Tanpa endpoint, tombol kirim membuka aplikasi email dengan pesan terisi.
# Isi endpoint layanan form (mis. Formspree: https://formspree.io/f/xxxx,
# atau Web3Forms: https://api.web3forms.com/submit) supaya pesan terkirim langsung.
PUBLIC_FORM_ENDPOINT=
# Khusus Web3Forms: access key dari dashboard mereka (boleh kosong untuk layanan lain).
PUBLIC_FORM_ACCESS_KEY=
