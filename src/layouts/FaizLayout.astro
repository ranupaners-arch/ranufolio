---
import Base from './Base.astro';
import ContactCard from '../components/faiz/ContactCard.astro';
import type { Lang } from '../data/content';

interface Props {
  lang: Lang;
  paths: Record<Lang, string>;
  title?: string;
  description?: string;
}
const { lang, paths, title, description } = Astro.props;
---

<Base lang={lang} paths={paths} title={title} description={description} variant="faiz">
  <div id="konten" class="faiz @container min-h-screen">
    <slot />
  </div>
  <div class="faiz fixed bottom-6 left-6 z-40 hidden bg-transparent sm:block" data-contact-dock>
    <ContactCard lang={lang} id="contact-card-dock" placement="side" />
  </div>
</Base>

<style is:global>
  html { background: #fff; scroll-behavior: smooth; }
  body { background: #fff; }
</style>
