---
import Base from './Base.astro';
import Header from '../components/site/Header.astro';
import ContactCta from '../components/site/ContactCta.astro';
import Footer from '../components/site/Footer.astro';
import TorchLight from '../components/site/TorchLight.astro';
import type { Lang } from '../data/content';

interface Props {
  lang: Lang;
  paths: Record<Lang, string> & { ar?: string };
  locale?: 'ar';
  current?: 'home' | 'learn' | 'resume' | 'contact';
  title?: string;
  description?: string;
  /** false = konten mengatur lebar sendiri (beranda dengan zona penuh lebar). */
  contained?: boolean;
  /** false = sembunyikan blok "Hubungi" (beranda sudah punya CTA sendiri). */
  contactCta?: boolean;
  initialTheme?: 'dark' | 'light';
}
const { lang, paths, locale, current, title, description, contained = true, contactCta = true, initialTheme } = Astro.props;
---

<Base lang={lang} paths={paths} locale={locale} title={title} description={description} variant="themed">
  <div class="grid-bg" aria-hidden="true"><TorchLight /></div>
  <Header lang={lang} paths={paths} locale={locale} current={current} initialTheme={initialTheme} />
  <main id="konten">
    {contained ? <div class="mx-auto max-w-[1180px] px-3.5 sm:px-7"><slot /></div> : <slot />}
  </main>
  <div class:list={['mx-auto max-w-[1180px] px-3.5 pb-6', contactCta && 'sm:px-7']}>
    {
      contactCta ? (
        <div class="glass mt-3 overflow-hidden rounded-[28px]">
          <ContactCta lang={locale ?? lang} />
          <Footer lang={lang} locale={locale} embedded />
        </div>
      ) : (
        <Footer lang={lang} locale={locale} />
      )
    }
  </div>
</Base>

<script>
  /* Animasi infinite (grid-drift, ping) dijeda saat di luar layar atau tab tersembunyi.
     startTime disimpan lalu dipasang lagi saat terlihat, jadi fase animasinya sama persis
     seperti tidak pernah dijeda (grid & sorotan obor tetap sejajar). Saat terlihat tidak ada yang berubah. */
  const targets = [...document.querySelectorAll<HTMLElement>('.grid-bg, .ping-dot')];
  if (targets.length && 'IntersectionObserver' in window) {
    const saved = new Map<Element, Map<Animation, number>>();
    const inView = new Set<Element>();
    const pause = (el: Element) => {
      const held = saved.get(el) ?? new Map<Animation, number>();
      for (const a of el.getAnimations({ subtree: true })) {
        if (held.has(a) || a.playState !== 'running' || a.startTime === null) continue;
        if (a.effect?.getComputedTiming().iterations !== Infinity) continue;
        held.set(a, Number(a.startTime));
        a.pause();
      }
      saved.set(el, held);
    };
    const resume = (el: Element) => {
      const held = saved.get(el);
      if (!held) return;
      held.forEach((start, a) => {
        if (a.playState === 'paused') a.startTime = start;
      });
      saved.delete(el);
    };
    const apply = (el: Element) => (inView.has(el) && !document.hidden ? resume(el) : pause(el));
    const io = new IntersectionObserver((entries) => {
      for (const e of entries) {
        if (e.isIntersecting) inView.add(e.target);
        else inView.delete(e.target);
        apply(e.target);
      }
    });
    targets.forEach((el) => io.observe(el));
    document.addEventListener('visibilitychange', () => targets.forEach(apply));
  }
</script>
