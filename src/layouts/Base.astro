---
import '../styles/global.css';
import { SITE, copy } from '../data/content';
import type { Lang } from '../data/content';

interface Props {
  lang: Lang;
  /** Path halaman ini di tiap bahasa, mis. { id: '/', en: '/en/' }. */
  paths: Record<Lang, string>;
  title?: string;
  description?: string;
}
const { lang, paths } = Astro.props;
const t = copy[lang];
const title = Astro.props.title ?? t.title;
const description = Astro.props.description ?? t.description;
const abs = (p: string) => new URL(p, SITE).href;
---

<!doctype html>
<html lang={t.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0d0d14" />
    <link rel="canonical" href={abs(paths[lang])} />
    <link rel="alternate" hreflang="id" href={abs(paths.id)} />
    <link rel="alternate" hreflang="en" href={abs(paths.en)} />
    <link rel="alternate" hreflang="x-default" href={abs(paths.id)} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Ranupane Rimba Argana" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={abs(paths[lang])} />
    <meta property="og:locale" content={lang === 'id' ? 'id_ID' : 'en_US'} />
    <meta property="og:image" content={abs('/ranupane.jpg')} />
    <meta name="twitter:card" content="summary" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wdth,wght@12..96,75..100,200..800&display=swap"
    />
  </head>
  <body>
    <a
      href="#konten"
      class="fixed left-3 top-3 z-50 -translate-y-20 rounded-md bg-sun px-4 py-3 text-sm font-medium text-ink focus:translate-y-0"
    >
      {t.skip}
    </a>
    <slot />
  </body>
</html>
