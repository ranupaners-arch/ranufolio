---
import Base from './Base.astro';
import ContactCard from '../components/portfolio/ContactCard.astro';
import type { Lang } from '../data/content';

interface Props {
  lang: Lang;
  paths: Record<Lang, string> & { ar?: string };
  locale?: 'ar';
  title?: string;
  description?: string;
}
const { lang, paths, locale, title, description } = Astro.props;
---

<Base lang={lang} paths={paths} locale={locale} title={title} description={description} variant="plain-page">
  <div id="konten" class="plain-page @container min-h-screen">
    <slot />
  </div>
  <div class:list={['plain-page fixed bottom-6 z-40 hidden bg-transparent sm:block', locale === 'ar' ? 'right-6' : 'left-6']} data-contact-dock>
    <ContactCard lang={lang} locale={locale} id="contact-card-dock" placement="side" />
  </div>
</Base>

<style is:global>
  html { background: #fff; scroll-behavior: smooth; }
  body { background: #fff; }
</style>
