---
import FaizLayout from '../../layouts/FaizLayout.astro';
import ProjectDetail from '../../components/faiz/ProjectDetail.astro';
import { projects, routes } from '../../data/content';

export function getStaticPaths() {
  return projects.map((p) => ({ params: { slug: p.slug } }));
}

const { slug } = Astro.params;
const p = projects.find((x) => x.slug === slug)!;
---

<FaizLayout
  lang="id"
  title={`${p.name} | Ranupane Rimba Argana`}
  description={p.tagline.id}
  paths={routes.pair((l) => routes.project(l, p.slug))}
>
  <ProjectDetail lang="id" slug={p.slug} />
</FaizLayout>
