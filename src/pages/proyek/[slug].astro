---
import DetailLayout from '../../layouts/DetailLayout.astro';
import ProjectDetail from '../../components/portfolio/ProjectDetail.astro';
import { arabicRoutes, projects, routes } from '../../data/content';

export function getStaticPaths() {
  return projects.map((p) => ({ params: { slug: p.slug } }));
}

const { slug } = Astro.params;
const p = projects.find((x) => x.slug === slug)!;
---

<DetailLayout
  lang="id"
  title={`${p.name} | Ranupane Rimba Argana`}
  description={p.tagline.id}
  paths={{ ...routes.pair((l) => routes.project(l, p.slug)), ar: arabicRoutes.project(p.slug) }}
>
  <ProjectDetail lang="id" slug={p.slug} />
</DetailLayout>
