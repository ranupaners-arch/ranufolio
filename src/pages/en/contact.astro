---
import PageLayout from '../../layouts/PageLayout.astro';
import ContactPage from '../../components/site/ContactPage.astro';
import { copy, routes } from '../../data/content';

const lang = 'en';
---

<PageLayout
  lang={lang}
  current="contact"
  paths={routes.pair((l) => routes.page(l, 'contact'))}
  title={`${copy[lang].contactPage.title} | Ranupane Rimba Argana`}
>
  <ContactPage lang={lang} />
</PageLayout>
