---
import PageLayout from '../../layouts/PageLayout.astro';
import ResumePage from '../../components/site/ResumePage.astro';
import { copy, routes } from '../../data/content';

const lang = 'en';
---

<PageLayout
  lang={lang}
  current="resume"
  paths={routes.pair((l) => routes.page(l, 'resume'))}
  title={`${copy[lang].resume.title} | Ranupane Rimba Argana`}
>
  <ResumePage lang={lang} />
</PageLayout>
