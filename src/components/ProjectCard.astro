---
import { copy, routes } from '../data/content';
import type { Lang, Project } from '../data/content';
import BrowserMock from './BrowserMock.astro';

interface Props {
  project: Project;
  lang: Lang;
}
const { project: p, lang } = Astro.props;
const t = copy[lang];
---

<a href={routes.project(lang, p.slug)} class="group block rounded-xl">
  <div
    class="relative aspect-[3/2] overflow-hidden rounded-xl transition-transform duration-200 group-hover:-translate-y-1"
    style={`background:${p.gradient}`}
  >
    <BrowserMock url={p.url} image={p.image} class="absolute inset-[15px]" />
  </div>
  <div class="mt-3 flex min-h-11 items-baseline justify-between gap-3">
    <span class="text-[17px] font-semibold">{p.name}</span>
    <span class="shrink-0 text-[15px] text-mute underline decoration-line underline-offset-4 group-hover:decoration-ink">
      {t.projects.view}
    </span>
  </div>
</a>
