---
import { copy, projects } from '../data/content';
import type { Lang } from '../data/content';
import Arrow from './Arrow.astro';
import ProjectCard from './ProjectCard.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = copy[lang];
---

<section id="proyek" class="scroll-mt-4 bg-paper">
  <div class="mx-auto max-w-[1240px] px-4 py-16 md:px-10 md:py-24">
    <div class="mb-8 flex items-end justify-between gap-4">
      <div>
        <h2 class="display text-4xl md:text-6xl">{t.projects.title}</h2>
        <p class="mt-3 text-[17px] text-mute">{t.projects.lead}</p>
      </div>
      <div class="flex shrink-0 gap-2 md:hidden">
        <button
          type="button"
          data-slide="-1"
          aria-label={t.projects.prev}
          class="grid size-11 place-items-center rounded-full bg-white ring-1 ring-line transition-colors hover:bg-ink hover:text-white"
        >
          <Arrow dir="left" />
        </button>
        <button
          type="button"
          data-slide="1"
          aria-label={t.projects.next}
          class="grid size-11 place-items-center rounded-full bg-white ring-1 ring-line transition-colors hover:bg-ink hover:text-white"
        >
          <Arrow dir="right" />
        </button>
      </div>
    </div>

    <!-- Mobile: carousel swipe, kartu berikutnya mengintip. Tablet ke atas: grid 3:2 -->
    <ul
      id="project-track"
      class="no-scrollbar -mx-4 flex scroll-pl-4 snap-x snap-mandatory gap-3 overflow-x-auto px-4 pb-2 md:mx-0 md:grid md:grid-cols-2 md:gap-5 md:overflow-visible md:px-0 lg:grid-cols-3"
    >
      {
        projects.map((p) => (
          <li class="w-[80%] shrink-0 snap-start md:w-auto">
            <ProjectCard project={p} lang={lang} />
          </li>
        ))
      }
    </ul>
  </div>
</section>

<script>
  const track = document.getElementById('project-track');
  document.querySelectorAll<HTMLButtonElement>('[data-slide]').forEach((btn) => {
    btn.addEventListener('click', () => {
      if (!track) return;
      const first = track.querySelector('li');
      const step = (first?.getBoundingClientRect().width ?? 280) + 12;
      track.scrollBy({ left: step * Number(btn.dataset.slide), behavior: 'smooth' });
    });
  });
</script>
