---
import { copy } from '../../data/content';
import type { Lang } from '../../data/content';
import { CONTRIB_URL, CONTRIB_USER as USER, MOBILE_WEEKS, layout, levelBg, levelOf, parse, summaryParts, summaryText } from '../../lib/contrib';
import type { Day } from '../../lib/contrib';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = copy[lang].shipping;

let days: Day[] = [];
try {
  // Render awal/fallback diambil saat build (API publik, tanpa token); klien menyegarkan data.
  const res = await fetch(CONTRIB_URL);
  if (res.ok) days = parse(await res.json()) ?? [];
} catch {
  days = [];
}
const { weeks, total, months } = layout(days);
const summary = summaryText(t.summary, lang, total, months);
const sp = summaryParts(t.summary, lang, total, months);
---

<section aria-labelledby="ship-h" class="glass rounded-[28px] p-6 sm:p-8">
  <!-- Desktop: blok shrink-to-fit di tengah kartu, heading/count selebar grid. Mobile tetap. -->
  <div class="md:mx-auto md:w-fit">
  <div class="flex items-center justify-between">
    <h2 id="ship-h" class="text-[14px] font-normal text-ink/65">{t.title}</h2>
    <a
      href={`https://github.com/${USER}`}
      target="_blank"
      rel="noopener"
      class="relative text-[14px] text-ink/65 transition-colors duration-150 ease-out after:absolute after:-inset-x-2 after:-inset-y-3 hover:text-ink"
      >@{USER}</a
    >
  </div>
  <div data-contrib-wrap hidden={!weeks.length}>
    <p class="mt-4 text-base leading-[1.6]">
      <span data-contrib-pre class="text-ink/65">{sp.pre}</span><span data-contrib-num class="font-medium tabular-nums text-ink">{sp.num}</span><span data-contrib-post class="text-ink/65">{sp.post}</span>
    </p>
    <div class="mt-4 flex justify-end overflow-x-clip md:justify-start">
      <div
        role="img"
        aria-label={summary}
        data-contrib
        data-lang={lang}
        data-one={t.one}
        data-many={t.many}
        data-on={t.on}
        data-none={t.none}
        data-tpl={t.summary}
        class="relative flex gap-[3px]"
      >
        <div data-cols class="contents">
          {weeks.map((w, i) => (
            <div class:list={['flex flex-col gap-[3px]', i < weeks.length - MOBILE_WEEKS && 'max-md:hidden']}>
              {w.map((d) =>
                d ? (
                  <span data-day data-date={d.date} data-c={d.count} class="ship-sq block size-3 rounded-[3px]" style={`background:${levelBg(levelOf(d.count))}`} />
                ) : (
                  <span class="block size-3" />
                ),
              )}
            </div>
          ))}
        </div>
        <div data-contrib-tip aria-hidden="true" class="ship-tip"><span class="font-medium tabular-nums" data-n></span><span class="text-[#ffffff99]" data-d></span></div>
      </div>
    </div>
  </div>
  <p data-contrib-empty hidden={!!weeks.length} class="mt-4 text-sm text-muted">{t.unavailable}</p>
  </div>
</section>

<style is:global>
  .ship-tip {
    position: absolute;
    top: 0;
    left: 0;
    z-index: 10;
    display: flex;
    height: 1.75rem;
    align-items: center;
    gap: 0.25rem;
    border-radius: 0.5rem;
    background: #0a0a0a;
    padding: 0 0.625rem;
    font-size: 13px;
    white-space: nowrap;
    color: #fff;
    pointer-events: none;
    box-shadow: 0 0 1px #0000000f, 0 4px 12px #00000024;
    --x: 0px;
    --y: 0px;
    --lift: 4px;
    transform-origin: 50% 100%;
    translate: calc(var(--x) - 50%) calc(var(--y) - 100% - 6px + var(--lift));
    opacity: 0;
    scale: 0.97;
    transition: opacity 0.1s, scale 0.1s;
  }
  .ship-tip[data-open] {
    --lift: 0px;
    opacity: 1;
    scale: 1;
    transition:
      opacity 0.15s,
      scale 0.15s,
      translate 0.14s cubic-bezier(0.23, 1, 0.32, 1);
  }
  .ship-tip[data-instant] {
    transition: none;
  }
  .ship-sq[data-active] {
    outline: 1px solid #0a0a0a40;
    outline-offset: 1px;
  }
  [data-theme='dark'] .ship-sq[data-active],
  .dark .ship-sq[data-active] {
    outline-color: #ffffff59;
  }
  @media (prefers-reduced-motion: reduce) {
    .ship-tip,
    .ship-tip[data-open] {
      transition: none;
    }
  }
</style>

<script>
  import { CONTRIB_URL, MOBILE_WEEKS, layout, levelBg, levelOf, parse, summaryParts, summaryText } from '../../lib/contrib';
  const grid = document.querySelector<HTMLElement>('[data-contrib]');
  const tip = document.querySelector<HTMLElement>('[data-contrib-tip]');
  const cols = grid?.querySelector<HTMLElement>('[data-cols]');
  if (grid && tip && cols) {
    const lang = grid.dataset.lang === 'id' ? 'id-ID' : 'en-US';
    const fmt = new Intl.DateTimeFormat(lang, { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC' });
    const tn = tip.querySelector<HTMLElement>('[data-n]')!;
    const td = tip.querySelector<HTMLElement>('[data-d]')!;
    let active: HTMLElement | null = null;
    const hide = () => {
      tip.removeAttribute('data-open');
      active?.removeAttribute('data-active');
      active = null;
    };
    const show = (sq: HTMLElement) => {
      if (active === sq) return;
      const wasOpen = tip.hasAttribute('data-open');
      active?.removeAttribute('data-active');
      active = sq;
      sq.setAttribute('data-active', '');
      const c = Number(sq.dataset.c);
      tn.textContent = c === 0 ? (grid.dataset.none ?? "") : `${c.toLocaleString(lang)} ${c === 1 ? grid.dataset.one : grid.dataset.many}`;
      td.textContent = `${grid.dataset.on} ${fmt.format(new Date(sq.dataset.date + 'T00:00:00Z'))}`;
      const g = grid.getBoundingClientRect();
      const r = sq.getBoundingClientRect();
      if (!wasOpen) tip.setAttribute('data-instant', '');
      // Jaga bubble tetap di dalam wrapper (overflow-x clip) agar teks panjang tidak terpotong.
      const wr = grid.parentElement!.getBoundingClientRect();
      const half = tip.offsetWidth / 2;
      const cx = Math.min(Math.max(r.left + r.width / 2, wr.left + half), wr.right - half);
      tip.style.setProperty('--x', `${cx - g.left}px`);
      tip.style.setProperty('--y', `${r.top - g.top}px`);
      if (!wasOpen) {
        void tip.offsetWidth;
        tip.removeAttribute('data-instant');
      }
      tip.setAttribute('data-open', '');
    };
    const sqOf = (e: Event) => (e.target as HTMLElement).closest<HTMLElement>('[data-day]');
    grid.addEventListener('pointerover', (e) => {
      if (e.pointerType !== 'mouse') return;
      const sq = sqOf(e);
      if (sq) show(sq);
    });
    grid.addEventListener('pointerleave', (e) => {
      if (e.pointerType === 'mouse') hide();
    });
    document.addEventListener('click', (e) => {
      const sq = grid.contains(e.target as Node) ? sqOf(e) : null;
      if (sq) {
        e.preventDefault();
        show(sq);
      } else hide();
    });
    // Segarkan data di klien; cache localStorage ~6 jam. Gagal = tetap pakai data build.
    const KEY = 'contrib:v1';
    const TTL = 6 * 36e5;
    const render = (days: import('../../lib/contrib').Day[]) => {
      const { weeks, total, months } = layout(days);
      if (!weeks.length) return;
      hide();
      const frag = document.createDocumentFragment();
      weeks.forEach((w, i) => {
        const col = document.createElement('div');
        col.className = 'flex flex-col gap-[3px]' + (i < weeks.length - MOBILE_WEEKS ? ' max-md:hidden' : '');
        for (const d of w) {
          const sq = document.createElement('span');
          sq.className = 'block size-3' + (d ? ' ship-sq rounded-[3px]' : '');
          if (d) {
            sq.dataset.day = '';
            sq.dataset.date = d.date;
            sq.dataset.c = String(d.count);
            sq.style.background = levelBg(levelOf(d.count));
          }
          col.append(sq);
        }
        frag.append(col);
      });
      cols.replaceChildren(frag);
      const l = grid.dataset.lang ?? 'en';
      const tpl = grid.dataset.tpl ?? '';
      grid.setAttribute('aria-label', summaryText(tpl, l, total, months));
      const sp = summaryParts(tpl, l, total, months);
      const q = (s: string) => document.querySelector<HTMLElement>(s);
      q('[data-contrib-pre]')!.textContent = sp.pre;
      q('[data-contrib-num]')!.textContent = sp.num;
      q('[data-contrib-post]')!.textContent = sp.post;
      q('[data-contrib-wrap]')!.hidden = false;
      q('[data-contrib-empty]')!.hidden = true;
      grid.dataset.fresh = '1';
    };
    let cached: { t: number; d: unknown } | null = null;
    try {
      cached = JSON.parse(localStorage.getItem(KEY) ?? 'null');
    } catch {}
    const cd = cached ? parse(cached.d) : null;
    if (cd) render(cd);
    if (!cached || !cd || Date.now() - cached.t > TTL) {
      fetch(CONTRIB_URL)
        .then((r) => (r.ok ? r.json() : null))
        .then((j) => {
          const d = parse(j);
          if (!d) return;
          try {
            localStorage.setItem(KEY, JSON.stringify({ t: Date.now(), d: { contributions: d } }));
          } catch {}
          render(d);
        })
        .catch(() => {});
    }
  }
</script>
