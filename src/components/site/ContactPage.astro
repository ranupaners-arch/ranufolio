---
import { contact, copy } from '../../data/content';
import type { Lang } from '../../data/content';

interface Props {
  lang: Lang | 'ar';
}
const { lang } = Astro.props;
const baseLang = lang === 'ar' ? 'en' : lang;
const t = copy[baseLang];
const f = lang === 'ar' ? {
  ...copy.en.contact.form,
  name: 'الاسم', email: 'البريد الإلكتروني', message: 'رسالتك',
  messagePlaceholder: 'اكتب نبذة عن نشاطك وما تحتاج إليه', send: 'إرسال الرسالة', sending: 'جارٍ الإرسال…',
  sent: 'تم إرسال رسالتك. سأرد عليك في أقرب وقت.',
  error: 'تعذّر إرسال الرسالة. حاول مرة أخرى أو تواصل معي عبر واتساب.',
  errName: 'يرجى إدخال الاسم.', errEmail: 'يرجى إدخال البريد الإلكتروني.',
  errEmailInvalid: 'يرجى إدخال بريد إلكتروني صحيح.', errMessage: 'يرجى كتابة رسالتك.',
  fallback: 'سيفتح تطبيق البريد لديك والرسالة جاهزة للإرسال.', subject: 'رسالة من الموقع',
} : t.contact.form;
const p = lang === 'ar' ? {
  ...copy.en.contactPage,
  title: 'ابدأ مشروعك',
  lead: 'أخبرني عن نشاطك التجاري وما الذي تحتاج إلى مساعدة التطبيق فيه. سأرد عليك في أقرب وقت.',
  need: 'ما الذي تحتاج إليه؟',
  needs: ['تطبيق ويب', 'نظام إدارة أو نقاط بيع', 'تطبيق جوّال', 'لست متأكدًا بعد'],
  namePlaceholder: 'الاسم الكامل', emailPlaceholder: 'name@example.com',
  messagePlaceholder: 'ما طبيعة نشاطك التجاري، وكيف يمكن للتطبيق مساعدتك؟',
  sendAnother: 'إرسال رسالة أخرى', sentTitle: 'شكرًا لك',
  whatsappTitle: 'واتساب', whatsappText: 'الأسرع. يفتح محادثة برسالة جاهزة.', emailTitle: 'البريد الإلكتروني',
} : t.contactPage;
const endpoint = import.meta.env.PUBLIC_FORM_ENDPOINT as string | undefined;
const accessKey = import.meta.env.PUBLIC_FORM_ACCESS_KEY as string | undefined;
---

<div dir={lang === 'ar' ? 'rtl' : undefined}>
  <section class="glass overflow-hidden rounded-[28px]">
    <header class="contact-header settle p-6 text-invink sm:p-10" style="--i:0">
      <h1 class="font-display text-[2.3rem] font-extrabold leading-none tracking-[-0.03em] sm:text-[3.4rem]">{p.title}</h1>
      <p class="mt-4 max-w-[54ch] text-lg leading-relaxed opacity-90">{p.lead}</p>
    </header>

    <div class="p-6 sm:p-8">
      <form
        data-contact-form
        data-endpoint={endpoint}
        data-email={contact.email}
        data-subject={f.subject}
        data-sending={f.sending}
        data-sent={f.sent}
        data-error={f.error}
        data-fallback={f.fallback}
        data-err-name={f.errName}
        data-err-email={f.errEmail}
        data-err-email-invalid={f.errEmailInvalid}
        data-err-message={f.errMessage}
        class="flex flex-col gap-5"
        novalidate
      >
        {accessKey && <input type="hidden" name="access_key" value={accessKey} />}
        <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" aria-hidden="true" class="hidden" />
        <div class="grid gap-5 sm:grid-cols-2">
          <label class="flex flex-col gap-2">
            <span class="text-sm font-semibold">{f.name}</span>
            <input class="field" type="text" name="name" autocomplete="name" placeholder={p.namePlaceholder} required aria-describedby="err-name" />
            <span id="err-name" data-err="name" class="text-sm font-semibold text-red-600" hidden></span>
          </label>
          <label class="flex flex-col gap-2">
            <span class="text-sm font-semibold">{f.email}</span>
            <input class="field" dir="ltr" type="email" name="email" autocomplete="email" placeholder={p.emailPlaceholder} required aria-describedby="err-email" />
            <span id="err-email" data-err="email" class="text-sm font-semibold text-red-600" hidden></span>
          </label>
        </div>
        <fieldset>
          <legend class="text-sm font-semibold">{p.need}</legend>
          <div class="mt-2 flex flex-wrap gap-2">
            {
              p.needs.map((n, i) => (
                <label class="cursor-pointer">
                  <input type="radio" class="peer sr-only" name="need" value={n} checked={i === 0} />
                  <span class="block rounded-full bg-soft px-4 py-2 text-sm font-semibold transition-colors hover:bg-line peer-checked:bg-inv peer-checked:text-invink peer-focus-visible:outline peer-focus-visible:outline-2 peer-focus-visible:outline-offset-2 peer-focus-visible:outline-[var(--ink)]">
                    {n}
                  </span>
                </label>
              ))
            }
          </div>
        </fieldset>
        <label class="flex flex-col gap-2">
          <span class="text-sm font-semibold">{f.message}</span>
          <textarea class="field resize-none" name="message" dir="auto" rows="5" placeholder={p.messagePlaceholder} required aria-describedby="err-message"></textarea>
          <span id="err-message" data-err="message" class="text-sm font-semibold text-red-600" hidden></span>
        </label>
        <div>
          <button
            type="submit"
            class="rounded-full bg-inv px-7 py-3.5 font-semibold text-invink transition-transform hover:-translate-y-0.5 disabled:cursor-not-allowed disabled:opacity-40 disabled:hover:translate-y-0"
          >
            {f.send}
          </button>
        </div>
        <p role="status" aria-live="polite" data-status class="min-h-6 text-[15px] text-muted empty:hidden"></p>
      </form>

      <div data-sent-card hidden class="flex flex-col items-start gap-3">
        <h2 class="font-display text-xl font-bold sm:text-2xl">{p.sentTitle}</h2>
        <p class="text-[17px] text-muted">{f.sent}</p>
        <button type="button" data-again class="rounded-full bg-soft px-5 py-2.5 text-sm font-semibold hover:bg-line">{p.sendAnother}</button>
      </div>
    </div>
  </section>
</div>

<style>
  .contact-header {
    background: linear-gradient(
      to bottom,
      var(--inv) calc(100% - 1.5rem),
      rgb(var(--glass-rgb) / calc(0.12 + var(--g) * 0.72)) 100%
    );
  }
</style>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-contact-form]');
  if (form) {
    const status = form.querySelector<HTMLElement>('[data-status]')!;
    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
    const sentCard = document.querySelector<HTMLElement>('[data-sent-card]')!;
    const sync = () => (button.disabled = false);
    let attempted = false;
    const fields = ['name', 'email', 'message'] as const;
    const msgFor = (el: HTMLInputElement | HTMLTextAreaElement) => {
      if (el.validity.valid) return '';
      if (el.name === 'email' && !el.validity.valueMissing) return form.dataset.errEmailInvalid ?? '';
      const key = { name: 'errName', email: 'errEmail', message: 'errMessage' }[el.name as (typeof fields)[number]];
      return form.dataset[key] ?? '';
    };
    const validate = () => {
      let ok = true;
      for (const n of fields) {
        const el = form.elements.namedItem(n) as HTMLInputElement | HTMLTextAreaElement;
        const err = form.querySelector<HTMLElement>(`[data-err="${n}"]`)!;
        const msg = msgFor(el);
        err.textContent = msg;
        err.hidden = !msg;
        el.setAttribute('aria-invalid', msg ? 'true' : 'false');
        if (msg) ok = false;
      }
      return ok;
    };
    form.addEventListener('input', () => attempted && validate());

    document.querySelector('[data-again]')?.addEventListener('click', () => {
      sentCard.hidden = true;
      form.hidden = false;
      status.textContent = '';
      sync();
    });

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      attempted = true;
      if (!validate()) {
        (form.querySelector('[aria-invalid="true"]') as HTMLElement | null)?.focus();
        return;
      }
      const data = new FormData(form);
      if (data.get('_gotcha')) return; // jebakan bot

      const need = data.get('need');
      const message = `[${need}]\n${data.get('message')}`;
      const endpoint = form.dataset.endpoint;
      if (endpoint) {
        data.set('message', message);
        button.disabled = true;
        status.textContent = form.dataset.sending ?? '';
        try {
          const res = await fetch(endpoint, { method: 'POST', body: data, headers: { Accept: 'application/json' } });
          if (!res.ok) throw new Error(String(res.status));
          form.reset();
          status.textContent = '';
          form.hidden = true;
          sentCard.hidden = false;
        } catch {
          status.textContent = form.dataset.error ?? '';
          sync();
        }
        return;
      }

      // Tanpa endpoint: buka aplikasi email dengan pesan yang sudah terisi.
      const subject = encodeURIComponent(form.dataset.subject ?? '');
      const body = encodeURIComponent(`${message}\n\n${data.get('name')}\n${data.get('email')}`);
      status.textContent = form.dataset.fallback ?? '';
      window.location.href = `mailto:${form.dataset.email}?subject=${subject}&body=${body}`;
    });
  }
</script>
