---
import { copy, learnCourse as c, routes, talks } from '../../data/content';
import type { Lang } from '../../data/content';
import Icon from '../Icon.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = copy[lang];
const l = t.learn;
const talk = talks[0];
const host = new URL(c.url).host + new URL(c.url).pathname.replace(/\/$/, '');
---

<div class="grid gap-3">
  <section class="settle glass rounded-[28px] p-6 sm:p-10" style="--i:0">
    <h1 class="font-display text-[2.3rem] font-extrabold leading-none tracking-[-0.03em] sm:text-[3.4rem]">{l.title}</h1>
    <p class="mt-4 max-w-[54ch] text-lg leading-relaxed text-muted">{l.lead}</p>
  </section>

  <section aria-labelledby="course-h" class="flex flex-col gap-6 rounded-[28px] bg-inv p-6 text-invink sm:p-10 lg:flex-row lg:items-end lg:justify-between">
    <div>
      <p class="text-sm font-semibold opacity-75">{l.kicker}</p>
      <h2 id="course-h" class="mt-2 font-display text-[2rem] font-extrabold leading-tight tracking-[-0.02em] sm:text-[2.8rem]">{c.title[lang]}</h2>
      <p class="mt-3 max-w-[52ch] text-[17px] leading-relaxed opacity-90">{c.text[lang]}</p>
      <p class="mt-2 text-sm opacity-70">{c.note[lang]}</p>
    </div>
    <div class="flex flex-wrap gap-3">
      <a
        href={c.url}
        target="_blank"
        rel="noopener noreferrer"
        class="group inline-flex items-center gap-2 rounded-full bg-invink px-6 py-3.5 font-semibold text-inv transition-transform hover:-translate-y-0.5"
      >
        {l.start}
        <Icon name="arrow-right" size={18} class="transition-transform group-hover:translate-x-0.5" />
      </a>
      <a
        href={c.url}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center rounded-full px-6 py-3.5 font-semibold shadow-[inset_0_0_0_1px_currentColor] transition-opacity hover:opacity-80"
      >
        {l.open}
      </a>
    </div>
  </section>

  <div class="grid gap-3 lg:grid-cols-12">
    <section aria-labelledby="curriculum-h" class="glass rounded-[28px] p-6 sm:p-8 lg:col-span-7">
      <h2 id="curriculum-h" class="font-display text-xl font-bold sm:text-2xl">{l.inside}</h2>
      <ol class="mt-5 flex flex-col gap-6">
        {
          c.modules.map((m, i) => (
            <li>
              <div class="flex flex-wrap items-baseline justify-between gap-x-3 gap-y-1">
                <p>
                  <span class="mr-2 text-sm font-semibold tabular-nums text-muted">
                    {l.module} {i}
                  </span>
                  <span class="font-display text-lg font-bold">{m.title[lang]}</span>
                </p>
                {m.lessons.length > 0 ? (
                  <span class="chip">{l.lessons(m.lessons.length)}</span>
                ) : (
                  <span class="chip !bg-transparent shadow-[inset_0_0_0_1px_var(--line)]">{l.soon}</span>
                )}
              </div>
              {m.lessons.length > 0 && (
                <ol class="mt-2 border-l border-line pl-4">
                  {m.lessons.map((ls, n) => (
                    <li>
                      <a
                        href={c.url}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="group flex items-center justify-between gap-4 rounded-xl py-2 text-[15.5px]"
                      >
                        <span>
                          <span class="mr-2 tabular-nums text-muted">{n + 1}.</span>
                          <span class="group-hover:underline">{ls[lang]}</span>
                        </span>
                        <Icon name="arrow-up-right" size={16} class="shrink-0 text-muted" />
                      </a>
                    </li>
                  ))}
                </ol>
              )}
            </li>
          ))
        }
      </ol>
    </section>

    <div class="flex flex-col gap-3 lg:col-span-5">
      <section class="glass rounded-[28px] p-6 sm:p-8">
        <h2 class="font-display text-xl font-bold">{l.forYou}</h2>
        <ul class="mt-4 flex flex-col gap-3">
          {
            c.forYou.map((f) => (
              <li class="flex gap-3 text-[15.5px]">
                <Icon name="check" size={18} class="mt-0.5 shrink-0" />
                {f[lang]}
              </li>
            ))
          }
        </ul>
      </section>
      <section class="glass rounded-[28px] p-6 sm:p-8">
        <h2 class="font-display text-xl font-bold">{l.asks}</h2>
        <dl class="mt-4 flex flex-col gap-3">
          {
            c.asks.map((a) => (
              <div class="grid grid-cols-[6rem_1fr] gap-3 text-[15.5px]">
                <dt class="font-semibold text-muted">{a.label[lang]}</dt>
                <dd>{a.text[lang]}</dd>
              </div>
            ))
          }
        </dl>
        <p class="mt-5 text-sm text-muted">{l.license}</p>
      </section>
    </div>
  </div>

  <section class="glass overflow-hidden rounded-[28px]" data-preview data-src={c.url} data-title={l.preview}>
    <div class="flex items-center justify-between gap-3 border-b border-line px-4 py-3 sm:px-5">
      <span class="min-w-0 truncate rounded-full bg-soft px-3 py-1.5 text-[13px] font-semibold text-muted">{host}</span>
      <a href={c.url} target="_blank" rel="noopener noreferrer" class="inline-flex shrink-0 items-center gap-1.5 text-sm font-semibold underline-offset-4 hover:underline">
        {l.newTab}
        <Icon name="arrow-up-right" size={15} />
      </a>
    </div>
    <div data-preview-body class="flex flex-col items-start gap-4 p-6 sm:flex-row sm:items-center sm:justify-between sm:p-8">
      <div>
        <h2 class="font-display text-xl font-bold sm:text-2xl">{l.preview}</h2>
        <p class="mt-1 text-[17px] text-muted">{l.previewText}</p>
      </div>
      <button
        type="button"
        data-preview-load
        class="group inline-flex shrink-0 items-center gap-2 rounded-full bg-inv px-6 py-3.5 font-semibold text-invink transition-transform hover:-translate-y-0.5"
      >
        {l.loadPreview}
        <Icon name="play" size={16} />
      </button>
    </div>
  </section>

  <a
    href={routes.talk(lang, talk.slug)}
    class="glass group flex items-center justify-between gap-4 rounded-[28px] p-6 transition-transform hover:-translate-y-0.5 sm:p-8"
  >
    <div>
      <p class="text-sm font-semibold text-muted">{l.workshop}</p>
      <h2 class="mt-1 font-display text-xl font-bold sm:text-2xl">{talk.title[lang]}</h2>
      <p class="mt-1 text-sm text-muted tabular-nums">{talk.meta[lang]}</p>
    </div>
    <span class="grid h-11 w-11 shrink-0 place-items-center rounded-full bg-soft transition-transform duration-300 group-hover:translate-x-1">
      <Icon name="arrow-right" />
    </span>
  </a>

</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-preview]').forEach((root) => {
    root.querySelector('[data-preview-load]')?.addEventListener('click', () => {
      const frame = document.createElement('iframe');
      frame.src = root.dataset.src!;
      frame.title = root.dataset.title ?? '';
      frame.loading = 'lazy';
      frame.className = 'block h-[72vh] min-h-[480px] w-full bg-white';
      root.querySelector('[data-preview-body]')!.replaceWith(frame);
    });
  });
</script>
