---
import { copy, featuredStack, techGroups } from '../../data/content';
import type { Lang } from '../../data/content';
import { brandHover, getIcon } from '../../lib/icons';
import TechChip from './TechChip.astro';

interface Props {
  lang: Lang;
  compact?: boolean;
}
const { lang, compact = false } = Astro.props;

const decorate = (i: { name: string; icon?: string[] }) => {
  const icon = getIcon(i.icon);
  return { name: i.name, icon, brand: brandHover(i.name, icon) };
};

const all = techGroups.flatMap((g) => g.items);
const featured = featuredStack.map((name) => all.find((i) => i.name === name)!).map(decorate);

const groups = techGroups
  .map((g) => ({
    label: g.label[lang],
    items: g.items.filter((i) => !compact || !featuredStack.includes(i.name)).map(decorate),
  }))
  .filter((g) => g.items.length > 0);
---

{
  compact && (
    <ul class="flex flex-wrap gap-1.5">
      {featured.map((item) => (
        <TechChip {...item} />
      ))}
    </ul>
  )
}

{
  compact ? (
    <details class="group/all mt-4">
      <summary class="inline-flex w-fit cursor-pointer list-none items-center gap-1.5 rounded-full bg-soft px-3.5 py-1.5 text-sm font-semibold [&::-webkit-details-marker]:hidden">
        <span class="group-open/all:hidden">{copy[lang].stack.all}</span>
        <span class="hidden group-open/all:inline">{copy[lang].stack.less}</span>
      </summary>
      <div class="mt-4 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {groups.map((g) => (
          <div>
            <p class="mb-2 text-sm font-semibold text-muted">{g.label}</p>
            <ul class="flex flex-wrap gap-1.5">
              {g.items.map((item) => (
                <TechChip {...item} />
              ))}
            </ul>
          </div>
        ))}
      </div>
    </details>
  ) : (
    <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {groups.map((g) => (
        <div>
          <p class="mb-2 text-sm font-semibold text-muted">{g.label}</p>
          <ul class="flex flex-wrap gap-1.5">
            {g.items.map((item) => (
              <TechChip {...item} />
            ))}
          </ul>
        </div>
      ))}
    </div>
  )
}
