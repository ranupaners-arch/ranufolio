---
// Kerangka halaman detail gaya Faiz: TOC 220px (>=1280) / akordeon "Contents", header, figure hero, slot badan, footer.
import { copy } from '../../data/content';
import type { Lang } from '../../data/content';
import Icon from '../Icon.astro';
import ContactCard from './ContactCard.astro';
import Figure from './Figure.astro';
import Lightbox from './Lightbox.astro';

interface Props {
  lang: Lang;
  otherHref: string;
  slug: string;
  backHref: string;
  backLabel: string;
  title: string;
  tagline: string;
  toc: { id: string; label: string }[];
  art: { gradient: string; url: string; image?: string };
  caption: string;
}
const { lang, otherHref, slug, backHref, backLabel, title, tagline, toc, art, caption } = Astro.props;
const t = copy[lang];
const other: Lang = lang === 'id' ? 'en' : 'id';
const linkCls = 'toc-link block text-[14px]/[1.5] text-fg/65 transition-colors duration-150 ease-out hover:text-fg';
---

<div class="relative">
  <aside class="absolute inset-y-0 left-10 hidden w-[220px] pt-[150px] @min-[1280px]:block" aria-label={t.detail.contents}>
    <nav class="sticky top-24 flex flex-col gap-3" data-toc>
      <p class="text-[14px] font-medium text-fg">{title}</p>
      <ul class="flex flex-col gap-1.5">
        {
          toc.map((i, n) => (
            <li>
              <a href={`#${i.id}`} class={linkCls} aria-current={n === 0 ? 'true' : undefined} data-toc-link={i.id}>
                {i.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </aside>

  <article class="page-grid gap-y-5 pb-32 pt-12 @3xl:pb-40 @3xl:pt-24 @5xl:pt-[150px]">
    <header id={`${slug}-top`} class="mb-5 scroll-mt-24">
      <div class="relative z-10 flex items-center justify-between">
        <a
          href={backHref}
          class="relative flex w-fit items-center gap-1 text-[14px] text-fg/65 transition-colors duration-150 ease-out after:absolute after:-inset-x-2 after:-inset-y-3 after:content-[''] hover:text-fg"
        >
          <Icon name="arrow-left" size={14} stroke={56} />
          {backLabel}
        </a>
        <div class="flex items-center gap-4">
          <a
            href={otherHref}
            hreflang={other}
            lang={other}
            aria-label={t.nav.switchAria}
            class="relative text-[14px] text-fg/65 transition-colors duration-150 ease-out after:absolute after:-inset-2 after:content-[''] hover:text-fg"
          >
            {t.nav.switchLabel}
          </a>
          <div class="@min-[640px]:hidden">
            <ContactCard lang={lang} id="contact-card-header" placement="below" />
          </div>
        </div>
      </div>
      <h1 class="mt-8 text-balance text-[18px]/[1.35] font-medium">{title}</h1>
      <p class="mt-1 text-balance text-[16px]/[1.6] text-fg/65">{tagline}</p>
      <p class="mt-4 flex flex-wrap items-center gap-x-2 text-[13px] text-fg/65 tabular-nums">
        <slot name="meta" />
      </p>
    </header>

    <details class="toc-row group mb-3 rounded-xl bg-bg-subtle ring-1 ring-inset ring-border-subtle @min-[1280px]:hidden">
      <summary class="flex cursor-default list-none items-center justify-between px-4 py-3 text-[14px] font-medium [&::-webkit-details-marker]:hidden">
        {t.detail.contents}
        <Icon name="chevron-down" size={16} stroke={56} class="transition-transform duration-150 ease-out group-open:rotate-180" />
      </summary>
      <nav class="border-t border-border-subtle px-4 py-3" aria-label={t.detail.contents} data-toc>
        <ul class="flex flex-col gap-2">
          {
            toc.map((i, n) => (
              <li>
                <a href={`#${i.id}`} class={linkCls} aria-current={n === 0 ? 'true' : undefined} data-toc-link={i.id}>
                  {i.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </details>

    <Figure gradient={art.gradient} url={art.url} image={art.image} caption={caption} zoom={t.detail.zoom} seed={0} />

    <slot />

    <footer class="mt-11 flex flex-col gap-10 border-t border-border-subtle pt-8">
      <slot name="footer" />
    </footer>
  </article>
</div>

<Lightbox close={t.detail.close} prev={t.detail.lightboxPrev} next={t.detail.lightboxNext} />

<script>
  const links = [...document.querySelectorAll<HTMLAnchorElement>('[data-toc-link]')];
  const ids = [...new Set(links.map((l) => l.dataset.tocLink!))];
  const heads = ids.map((id) => document.getElementById(id)).filter(Boolean) as HTMLElement[];
  const setActive = (id: string) =>
    links.forEach((l) => {
      if (l.dataset.tocLink === id) l.setAttribute('aria-current', 'true');
      else l.removeAttribute('aria-current');
    });
  if (heads.length) {
    const pick = () => {
      let current = heads[0].id;
      for (const h of heads) if (h.getBoundingClientRect().top < innerHeight * 0.3) current = h.id;
      setActive(current);
    };
    const io = new IntersectionObserver(pick, { rootMargin: '0px 0px -70% 0px' });
    heads.forEach((h) => io.observe(h));
    addEventListener('scroll', pick, { passive: true });
    pick();
  }
  document.querySelectorAll<HTMLDetailsElement>('details.toc-row').forEach((d) =>
    d.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => d.removeAttribute('open'))),
  );
</script>
