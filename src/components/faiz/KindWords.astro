---
import { copy, testimonials } from '../../data/content';
import type { Lang } from '../../data/content';
import Icon from '../Icon.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = copy[lang];
const n = testimonials.length;
const initials = (name: string) =>
  name
    .split(/\s+/)
    .slice(0, 2)
    .map((w) => w.charAt(0).toUpperCase())
    .join('');
const btn =
  'relative grid size-8 place-items-center rounded-full text-fg/65 transition-[background-color,color] duration-150 ease-out after:absolute after:-inset-1.5 hover:bg-bg-hover hover:text-fg active:scale-[0.96]';
---

<section data-zone="light" class="faiz @container" aria-labelledby="kind-h">
  <div class="page-grid pb-20 pt-16 @3xl:pb-[120px] @3xl:pt-24">
    <div class="kind-words" data-quotes>
      <div class="flex items-center justify-between">
        <h2 id="kind-h" class="text-[14px] text-fg/65">{t.testimonial.title}</h2>
        {
          n > 1 && (
            <div class="flex items-center gap-1">
              <span data-count class="mr-1 text-[13px] tabular-nums text-fg/65">
                1 / {n}
              </span>
              <button type="button" data-prev aria-label={t.testimonial.prev} class={btn}>
                <Icon name="chevron-left" size={16} stroke={64} />
              </button>
              <button type="button" data-next aria-label={t.testimonial.next} class={btn}>
                <Icon name="chevron-right" size={16} stroke={64} />
              </button>
            </div>
          )
        }
      </div>

      <div class="mt-4 grid" aria-live="polite">
        {
          testimonials.map((q, i) => (
            <figure
              data-slide
              data-active={i === 0 ? '' : undefined}
              aria-hidden={i === 0 ? undefined : 'true'}
              class="kw-slide col-start-1 row-start-1 flex flex-col justify-between gap-5"
            >
              <blockquote class="text-pretty text-[18px]/[1.5] tracking-[-0.01em] @3xl:text-balance">{q.quote[lang]}</blockquote>
              <figcaption class="flex items-center gap-2.5 text-[14px]">
                <span
                  aria-hidden="true"
                  class="grid size-7 shrink-0 place-items-center rounded-lg bg-bg-muted text-[11px] font-medium ring-1 ring-inset ring-black/10"
                >
                  {initials(q.name)}
                </span>
                <span>
                  {q.name} · <span class="text-fg/65">{q.role[lang]}</span>
                </span>
              </figcaption>
            </figure>
          ))
        }
      </div>
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-quotes]').forEach((root) => {
    const slides = [...root.querySelectorAll<HTMLElement>('[data-slide]')];
    const count = root.querySelector<HTMLElement>('[data-count]');
    let i = 0;
    const show = (n: number) => {
      i = (n + slides.length) % slides.length;
      slides.forEach((s, k) => {
        const on = k === i;
        s.toggleAttribute('data-active', on);
        if (on) s.removeAttribute('aria-hidden');
        else s.setAttribute('aria-hidden', 'true');
      });
      if (count) count.textContent = `${i + 1} / ${slides.length}`;
    };
    root.querySelector('[data-prev]')?.addEventListener('click', () => show(i - 1));
    root.querySelector('[data-next]')?.addEventListener('click', () => show(i + 1));
  });
</script>
