---
// Kartu kontak ala Faiz: avatar + kartu yang terbuka lewat clip-path. Aksi utama = WhatsApp (tanpa form).
import { contact, copy, person } from '../../data/content';
import type { Lang } from '../../data/content';
import Icon from '../Icon.astro';
import { getIcon } from '../../lib/icons';

interface Props {
  lang: Lang;
  id: string;
  placement: 'side' | 'below';
}
const { lang, id, placement } = Astro.props;
const t = copy[lang];
const waHref = `https://wa.me/${contact.whatsapp}?text=${encodeURIComponent(t.contact.waText)}`;
const links = [
  { label: 'WhatsApp', href: waHref, icon: getIcon(['siWhatsapp']) },
  ...contact.socials.map((s) => ({ label: s.label, href: s.url, icon: getIcon(s.icon) })),
];
const avatar =
  'block size-10 rounded-xl bg-[url(/ranupane.jpg)] bg-cover bg-[position:50%_25%] outline-1 -outline-offset-[0.5px] outline-border';
const item =
  'contact-item relative flex size-9 items-center justify-center rounded-full text-fg-secondary before:absolute before:inset-x-0 before:-inset-y-1 hover:bg-bg-muted hover:text-fg';
---

<div class="relative size-10" data-contact data-state="closed" data-placement={placement}>
  <button type="button" class="relative block size-10 rounded-xl" aria-label={`${t.detail.contactCard} ${person.short}`} aria-expanded="false" aria-controls={id} data-contact-avatar>
    <span class="contact-ring pointer-events-none absolute -inset-1 rounded-2xl"></span>
    <span class={avatar}></span>
    <span class="absolute -right-0.5 -bottom-0.5 size-3 rounded-full bg-success ring-2 ring-bg"></span>
  </button>
  {placement === 'side' && <span class="absolute bottom-[-2px] left-10 h-11 w-3" aria-hidden="true"></span>}

  <div
    class:list={[
      'contact-shadow pointer-events-none absolute z-40',
      placement === 'side' ? 'bottom-[-2px] left-[52px]' : 'right-0 top-[52px]',
    ]}
  >
    <span class="contact-plate pointer-events-none absolute rounded-[22px]" aria-hidden="true"></span>
    <div
      id={id}
      role="group"
      aria-label={`${t.detail.contactCard} ${person.short}`}
      class:list={[
        'contact-card relative flex flex-col rounded-[22px] bg-bg',
        placement === 'side' ? 'w-[321px]' : 'w-[min(321px,calc(100cqw-40px))]',
      ]}
    >
      <div class="contact-grown flex flex-col gap-3.5 px-4 pt-4">
        <div class="contact-piece flex items-center gap-3" style="--i:0">
          <span class="block size-11 shrink-0 rounded-[13px] bg-[url(/ranupane.jpg)] bg-cover bg-[position:50%_25%]"></span>
          <span class="flex flex-col gap-0.5">
            <span class="text-[16px] font-medium">{person.name}</span>
            <span class="text-[13px] text-fg/65">{t.hero.role} · {person.city}</span>
          </span>
        </div>
        <span class="contact-piece flex w-fit items-center gap-1.5 rounded-full bg-success/10 px-2.5 py-[5px] text-[13px] font-medium text-[#1a7f2b]" style="--i:1">
          <span class="size-[7px] rounded-full bg-success"></span>
          {t.detail.available}
        </span>
      </div>
      <div class="contact-actions flex flex-col gap-3.5 px-4 pb-3 pt-3.5">
        <a
          href={waHref}
          target="_blank"
          rel="noopener noreferrer"
          style="--i:2"
          class="contact-piece relative flex h-11 w-full items-center justify-center gap-2 rounded-full bg-bg-inverse text-[14px] font-medium text-fg-inverse transition-[scale,opacity] duration-150 ease-out active:scale-[0.97] motion-reduce:transition-none"
        >
          <Icon name="mail" size={16} stroke={40} />
          {t.detail.write}
        </a>
        <p class="contact-piece text-center text-[13px] text-fg/65" style="--i:3">
          <a href={`mailto:${contact.email}`} class="text-fg underline decoration-fg/30 underline-offset-[3px] hover:decoration-fg">{contact.email}</a>
        </p>
      </div>
      <div class="h-px bg-border-subtle"></div>
      <div class="flex h-11 items-center gap-0.5 p-1">
        <a style="--i:0" href={`mailto:${contact.email}`} aria-label="Email" title="Email" class={item}>
          <Icon name="mail" size={18} stroke={36} />
        </a>
        {
          links.map((l, i) => (
            <a style={`--i:${i + 1}`} href={l.href} target="_blank" rel="noopener noreferrer" aria-label={l.label} title={l.label} class={item}>
              {l.icon ? (
                <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true">
                  <path d={l.icon.path} />
                </svg>
              ) : (
                <span class="text-[11px] font-bold">{l.label.charAt(0)}</span>
              )}
            </a>
          ))
        }
        <span class="contact-item mx-1 h-5 w-px bg-border" style={`--i:${links.length + 1}`} aria-hidden="true"></span>
        <button
          type="button"
          class={item}
          style={`--i:${links.length + 2}`}
          aria-label={t.detail.contactCard}
          aria-expanded="false"
          aria-controls={id}
          data-contact-toggle
        >
          <span class="contact-swap contact-swap-open absolute"><Icon name="chevron-down" size={16} stroke={56} class="rotate-180" /></span>
          <span class="contact-swap contact-swap-close absolute"><Icon name="close" size={16} stroke={56} /></span>
        </button>
      </div>
    </div>
  </div>
</div>

<style is:global>
  .contact-ring { box-shadow: 0 0 0 0 transparent; }
  .contact-plate {
    box-shadow: var(--shadow-dialog);
    opacity: 0;
    transition: inset 0.22s var(--ease-out), opacity 0.12s var(--ease-out) 0.1s;
    inset: calc(100% - 44px) calc(100% - 44px) 0 0;
  }
  [data-state='peek'] .contact-plate { opacity: 1; transition: inset 0.3s var(--ease-out), opacity 0.15s var(--ease-out); inset: calc(100% - 44px) 0 0; }
  [data-state='open'] .contact-plate { opacity: 1; transition: inset 0.3s var(--ease-out), opacity 0.15s var(--ease-out); inset: 0; }
  .contact-shadow { opacity: 0; transition: opacity 0.1s var(--ease-out) 0.12s, translate 0.22s var(--ease-out); translate: -4px; }
  [data-state='peek'] .contact-shadow, [data-state='open'] .contact-shadow { opacity: 1; transition: opacity 0.12s var(--ease-out), translate 0.28s var(--ease-out); translate: 0; }
  .contact-card {
    visibility: hidden;
    clip-path: inset(calc(100% - 44px) calc(100% - 44px) 0 0 round 22px);
    transition: clip-path 0.22s var(--ease-out), visibility 0s 0.22s;
  }
  [data-state='peek'] .contact-card { visibility: visible; pointer-events: auto; clip-path: inset(calc(100% - 44px) 0 0 round 22px); transition: clip-path 0.3s var(--ease-out), visibility 0s; }
  [data-state='open'] .contact-card { visibility: visible; pointer-events: auto; clip-path: inset(0 round 22px); transition: clip-path 0.3s var(--ease-out), visibility 0s; }
  .contact-item { opacity: 0; transition: opacity 0.1s var(--ease-out), translate 0.12s var(--ease-out), scale 0.12s var(--ease-out), background-color 0.15s var(--ease-out), color 0.15s var(--ease-out); translate: -8px; scale: 0.88; }
  [data-state='peek'] .contact-item, [data-state='open'] .contact-item {
    opacity: 1; translate: 0; scale: 1;
    transition: opacity 0.18s var(--ease-out) calc(50ms + var(--i) * 24ms), translate 0.28s var(--ease-back) calc(50ms + var(--i) * 24ms), scale 0.28s var(--ease-back) calc(50ms + var(--i) * 24ms), background-color 0.15s var(--ease-out), color 0.15s var(--ease-out);
  }
  .contact-grown, .contact-actions { visibility: hidden; transition: visibility 0s 0.2s; }
  [data-state='open'] .contact-grown, [data-state='open'] .contact-actions { visibility: visible; transition: visibility 0s; }
  .contact-piece { opacity: 0; transition: opacity 0.15s var(--ease-out), translate 0.15s var(--ease-out); translate: 0 8px; }
  [data-state='open'] .contact-piece { opacity: 1; translate: 0; transition-duration: 0.25s; transition-delay: calc(80ms + var(--i) * 60ms); }
  .contact-swap { transition: opacity 0.25s var(--ease-out), scale 0.25s var(--ease-out), filter 0.25s var(--ease-out); }
  .contact-swap-close, [data-state='open'] .contact-swap-open { opacity: 0; scale: 0.6; filter: blur(2px); }
  [data-state='open'] .contact-swap-close { opacity: 1; scale: 1; filter: none; }
  @media (prefers-reduced-motion: reduce) {
    .contact-shadow, .contact-plate, .contact-card, .contact-item, .contact-piece, .contact-swap { transition: none !important; }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-contact]').forEach((root) => {
    const avatar = root.querySelector<HTMLButtonElement>('[data-contact-avatar]')!;
    const toggle = root.querySelector<HTMLButtonElement>('[data-contact-toggle]')!;
    const canHover = matchMedia('(hover: hover) and (pointer: fine)').matches;
    let state = 'closed';
    let timer = 0;
    const set = (s: string) => {
      state = s;
      root.dataset.state = s;
      const open = s === 'open';
      avatar.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-expanded', String(open));
    };
    const flip = () => set(state === 'open' ? 'closed' : 'open');
    avatar.addEventListener('click', flip);
    toggle.addEventListener('click', flip);
    if (canHover && root.dataset.placement === 'side') {
      root.addEventListener('pointerenter', () => {
        clearTimeout(timer);
        if (state === 'closed') set('peek');
      });
      root.addEventListener('pointerleave', () => {
        clearTimeout(timer);
        timer = window.setTimeout(() => state === 'peek' && set('closed'), 150);
      });
    }
    document.addEventListener('pointerdown', (e) => {
      if (state !== 'closed' && !root.contains(e.target as Node)) set('closed');
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && state !== 'closed') {
        set('closed');
        avatar.focus();
      }
    });
  });
</script>
