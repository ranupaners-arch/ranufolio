---
import { copy, resume } from '../../data/content';
import type { Lang, ResumeEntry } from '../../data/content';
import WorksWith from './WorksWith.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = copy[lang];
const r = t.resume;
const lists = [
  { title: r.experience, entries: resume.experience },
  { title: r.education, entries: resume.education },
];
const h2 = 'mt-5 px-1.5 font-display text-[1.5rem] font-extrabold tracking-[-0.02em] sm:text-[1.9rem]';
const li = 'list-disc flex-col gap-1.5 pl-5 text-[15.5px] marker:text-muted';
const split = (e: ResumeEntry) => [e.bullets.slice(0, 2), e.bullets.slice(2)] as const;
---

<div class="grid gap-3">
  <section class="settle glass rounded-[28px] p-6 sm:p-10" style="--i:0">
    <h1 class="font-display text-[2.3rem] font-extrabold leading-none tracking-[-0.03em] sm:text-[3.4rem]">{r.title}</h1>
    <p class="mt-4 max-w-[54ch] text-lg leading-relaxed text-muted">{r.lead}</p>
  </section>

  {
    lists.map((l) => (
      <>
        <h2 class={h2}>{l.title}</h2>
        <ol class="glass rounded-[28px] px-6 sm:px-8">
          {l.entries.map((e) => {
            const [first, more] = split(e);
            return (
              <li class="grid gap-2 border-b border-line py-7 last:border-0 md:grid-cols-[13rem_1fr] md:gap-10">
                <div class="flex flex-wrap items-start gap-2 md:flex-col">
                  <span class="text-sm font-semibold tabular-nums text-muted">{e.period[lang]}</span>
                  {e.current && <span class="chip !bg-inv !text-invink">{r.current}</span>}
                </div>
                <div>
                  <h3 class="font-display text-xl font-bold">
                    {e.title}
                    <span class="ml-2 font-sans text-sm font-medium text-muted">{e.place}</span>
                  </h3>
                  <p class="font-semibold">{e.role[lang]}</p>
                  <ul class={`mt-3 flex max-w-[66ch] ${li}`}>
                    {first.map((b) => <li>{b[lang]}</li>)}
                  </ul>
                  {more.length > 0 && (
                    <details class="group mt-3 max-w-[66ch]">
                      <summary class="w-fit cursor-pointer list-none rounded-full bg-soft px-3.5 py-1.5 text-sm font-semibold hover:bg-line [&::-webkit-details-marker]:hidden">
                        <span class="group-open:hidden">{r.showMore(more.length)}</span>
                        <span class="hidden group-open:inline">{r.showLess}</span>
                      </summary>
                      <ul class={`mt-3 flex ${li}`}>
                        {more.map((b) => <li>{b[lang]}</li>)}
                      </ul>
                    </details>
                  )}
                </div>
              </li>
            );
          })}
        </ol>
      </>
    ))
  }

  <h2 class={h2}>{r.stack}</h2>
  <section class="glass rounded-[28px] p-6 sm:p-8">
    <WorksWith lang={lang} />
  </section>
</div>
