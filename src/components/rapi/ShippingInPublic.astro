---
import { copy } from '../../data/content';
import type { Lang } from '../../data/content';
import { CONTRIB_URL, CONTRIB_USER as USER, layout, levelBg, parse, summaryText } from '../../lib/contrib';
import type { Day } from '../../lib/contrib';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = copy[lang].shipping;

let days: Day[] = [];
try {
  // Render awal/fallback diambil saat build (API publik, tanpa token); klien menyegarkan data.
  const res = await fetch(CONTRIB_URL);
  if (res.ok) days = parse(await res.json()) ?? [];
} catch {
  days = [];
}
const { weeks, total, months } = layout(days);
const summary = summaryText(t.summary, lang, total, months);
---

<section aria-labelledby="ship-h" class="glass rounded-[28px] p-6 sm:p-8">
  <div class="flex items-baseline justify-between gap-4">
    <h2 id="ship-h" class="text-sm font-semibold text-muted">{t.title}</h2>
    <a href={`https://github.com/${USER}`} target="_blank" rel="noopener" class="text-sm font-semibold hover:underline">@{USER}</a>
  </div>
  <div data-contrib-wrap hidden={!weeks.length}>
    <div data-contrib-scroll class="mt-4 overflow-x-auto pb-1">
      <div
        role="img"
        aria-label={summary}
        data-contrib
        data-lang={lang}
        data-one={t.one}
        data-many={t.many}
        data-on={t.on}
        data-tpl={t.summary}
        class="flex w-max gap-[3px]"
      >
        {weeks.map((w) => (
          <div class="flex flex-col gap-[3px]">
            {w.map((d) =>
              d ? (
                <span data-day data-date={d.date} data-c={d.count} class="block size-3 rounded-[3px]" style={`background:${levelBg(d.level)}`} />
              ) : (
                <span class="block size-3" />
              ),
            )}
          </div>
        ))}
      </div>
    </div>
    <p data-contrib-summary class="mt-3 text-sm text-muted">{summary}</p>
  </div>
  <p data-contrib-empty hidden={!!weeks.length} class="mt-4 text-sm text-muted">{t.unavailable}</p>
  <div
    data-contrib-tip
    hidden
    class="pointer-events-none fixed z-[100] whitespace-nowrap rounded-lg bg-[#0a0a0a] px-2.5 py-1.5 text-xs text-white shadow-lg"
  />
</section>

<script>
  import { CONTRIB_URL, layout, levelBg, parse, summaryText } from '../../lib/contrib';
  const grid = document.querySelector<HTMLElement>('[data-contrib]');
  const tip = document.querySelector<HTMLElement>('[data-contrib-tip]');
  if (grid && tip) {
    const lang = grid.dataset.lang === 'id' ? 'id-ID' : 'en-US';
    const fmt = new Intl.DateTimeFormat(lang, { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC' });
    let active: HTMLElement | null = null;
    const hide = () => {
      tip.hidden = true;
      active?.classList.remove('outline', 'outline-1', 'outline-offset-1', 'outline-[var(--ink)]');
      active = null;
    };
    const show = (sq: HTMLElement) => {
      if (active === sq && !tip.hidden) return;
      hide();
      active = sq;
      sq.classList.add('outline', 'outline-1', 'outline-offset-1', 'outline-[var(--ink)]');
      const c = Number(sq.dataset.c);
      const word = c === 1 ? grid.dataset.one : grid.dataset.many;
      const b = document.createElement('b');
      b.className = 'font-semibold';
      b.textContent = `${c.toLocaleString(lang)} ${word}`;
      const s = document.createElement('span');
      s.className = 'text-white/60';
      s.textContent = ` ${grid.dataset.on} ${fmt.format(new Date(sq.dataset.date + 'T00:00:00Z'))}`;
      tip.replaceChildren(b, s);
      tip.hidden = false;
      const r = sq.getBoundingClientRect();
      const tw = tip.offsetWidth;
      const th = tip.offsetHeight;
      const left = Math.min(Math.max(8, r.left + r.width / 2 - tw / 2), window.innerWidth - tw - 8);
      let top = r.top - th - 8;
      if (top < 8) top = r.bottom + 8;
      tip.style.left = `${left}px`;
      tip.style.top = `${top}px`;
    };
    const sqOf = (e: Event) => (e.target as HTMLElement).closest<HTMLElement>('[data-day]');
    grid.addEventListener('pointerover', (e) => {
      if (e.pointerType !== 'mouse') return;
      const sq = sqOf(e);
      if (sq) show(sq);
    });
    grid.addEventListener('pointerleave', (e) => {
      if (e.pointerType === 'mouse') hide();
    });
    document.addEventListener('click', (e) => {
      const sq = grid.contains(e.target as Node) ? sqOf(e) : null;
      if (sq) show(sq);
      else hide();
    });
    window.addEventListener('scroll', hide, { passive: true });
    // Segarkan data di klien; cache localStorage ~6 jam. Gagal = tetap pakai data build.
    const KEY = 'contrib:v1';
    const TTL = 6 * 36e5;
    const render = (days: import('../../lib/contrib').Day[]) => {
      const { weeks, total, months } = layout(days);
      if (!weeks.length) return;
      hide();
      const frag = document.createDocumentFragment();
      for (const w of weeks) {
        const col = document.createElement('div');
        col.className = 'flex flex-col gap-[3px]';
        for (const d of w) {
          const sq = document.createElement('span');
          sq.className = 'block size-3' + (d ? ' rounded-[3px]' : '');
          if (d) {
            sq.dataset.day = '';
            sq.dataset.date = d.date;
            sq.dataset.c = String(d.count);
            sq.style.background = levelBg(d.level);
          }
          col.append(sq);
        }
        frag.append(col);
      }
      grid.replaceChildren(frag);
      const text = summaryText(grid.dataset.tpl ?? '', grid.dataset.lang ?? 'en', total, months);
      grid.setAttribute('aria-label', text);
      const sum = document.querySelector<HTMLElement>('[data-contrib-summary]');
      if (sum) sum.textContent = text;
      document.querySelector<HTMLElement>('[data-contrib-wrap]')!.hidden = false;
      document.querySelector<HTMLElement>('[data-contrib-empty]')!.hidden = true;
      grid.dataset.fresh = '1';
    };
    let cached: { t: number; d: unknown } | null = null;
    try {
      cached = JSON.parse(localStorage.getItem(KEY) ?? 'null');
    } catch {}
    const cd = cached ? parse(cached.d) : null;
    if (cd) render(cd);
    if (!cached || !cd || Date.now() - cached.t > TTL) {
      fetch(CONTRIB_URL)
        .then((r) => (r.ok ? r.json() : null))
        .then((j) => {
          const d = parse(j);
          if (!d) return;
          try {
            localStorage.setItem(KEY, JSON.stringify({ t: Date.now(), d: { contributions: d } }));
          } catch {}
          render(d);
        })
        .catch(() => {});
    }
    grid.parentElement?.addEventListener('scroll', hide, { passive: true });
  }
</script>
