---
import { copy, person, routes } from '../../data/content';
import type { Lang } from '../../data/content';
import Icon from '../Icon.astro';

interface Props {
  lang: Lang;
  paths: Record<Lang, string>;
  current?: 'home' | 'learn' | 'resume' | 'contact';
  /** Tema header di posisi awal (halaman yang dibuka dengan zona hero gelap memakai 'dark'). */
  initialTheme?: 'dark' | 'light';
}
const { lang, paths, current, initialTheme } = Astro.props;
const t = copy[lang];
const other: Lang = lang === 'id' ? 'en' : 'id';

const items = [
  { key: 'home', label: t.nav.home, href: routes.home[lang] },
  { key: 'learn', label: t.nav.learn, href: routes.page(lang, 'learn') },
  { key: 'resume', label: t.nav.resume, href: routes.page(lang, 'resume') },
  { key: 'contact', label: t.nav.contact, href: routes.page(lang, 'contact') },
] as const;
const m = t.menu;
const icons = { home: 'home', learn: 'book', resume: 'document', contact: 'mail' } as const;
const themes = [
  ['light', m.light],
  ['dark', m.dark],
  ['auto', m.auto],
] as const;
---

<header data-rapi-header data-theme={initialTheme} class="sticky top-0 z-40 text-ink">
  <div data-header-row class="relative mx-auto flex max-w-[1180px] items-center gap-2 px-3.5 py-3.5 sm:px-7 sm:py-5">
    <a
      href={routes.home[lang]}
      aria-label={t.nav.homeAria}
      class="hidden px-1.5 font-display text-lg font-extrabold tracking-[-0.02em] sm:block"
    >
      {person.short}
    </a>

    <nav aria-label={t.nav.aria} class="glass hidden rounded-full p-1 sm:absolute sm:left-1/2 sm:block sm:-translate-x-1/2">
      <ul class="relative flex">
        {
          items.map((i) => {
            const active = i.key === current;
            return (
              <li class="relative">
                <a
                  href={i.href}
                  aria-current={active ? 'page' : undefined}
                  style={active ? 'view-transition-name:nav-pill' : undefined}
                  class:list={[
                    'block rounded-full px-4 py-2 text-sm font-semibold transition-colors duration-300',
                    active ? 'bg-inv text-invink' : 'hover:bg-soft',
                  ]}
                >
                  {i.label}
                </a>
              </li>
            );
          })
        }
      </ul>
    </nav>

    <div data-tools class="ml-auto flex items-center gap-2">
      <a
        href={paths[other]}
        hreflang={other}
        lang={other}
        aria-label={t.nav.switchAria}
        title={t.nav.switchAria}
        class="glass hidden h-11 w-11 shrink-0 place-items-center rounded-full text-[13px] font-bold uppercase transition-transform duration-300 hover:scale-105 active:scale-95 min-[430px]:grid sm:grid"
      >
        {other}
      </a>

      <div class="relative">
        <button
          type="button"
          data-settings-btn
          aria-expanded="false"
          aria-controls="settings-pop"
          aria-label={t.nav.settings}
          class="glass grid h-11 w-11 place-items-center rounded-full transition-transform duration-300 hover:scale-105 active:scale-95"
        >
          <Icon name="theme" size={19} />
        </button>

        <div
          id="settings-pop"
          data-settings-pop
          hidden
          class="glass glass-strong absolute right-0 top-[calc(100%+8px)] z-50 w-[260px] rounded-2xl p-4 shadow-[0_8px_20px_-10px_rgb(0_0_0/0.35)]"
        >
          <p class="text-[13px] font-semibold text-muted">{m.theme}</p>
          <div role="radiogroup" aria-label={m.theme} class="mt-2 grid grid-cols-3 gap-1 rounded-xl bg-soft p-1">
            {
              themes.map(([value, label]) => (
                <button
                  type="button"
                  role="radio"
                  aria-checked="false"
                  data-theme-opt={value}
                  class="rounded-lg py-1.5 text-[13px] font-semibold text-muted transition-colors hover:text-ink aria-checked:bg-panel aria-checked:text-ink aria-checked:shadow-[0_1px_2px_rgb(0_0_0/0.12)]"
                >
                  {label}
                </button>
              ))
            }
          </div>

          <div class="mt-4 flex items-center justify-between text-[13px] font-semibold">
            <label for="glass-range" class="text-muted">{m.glass}</label>
            <span data-glass-label class="tabular-nums">55%</span>
          </div>
          <input id="glass-range" data-glass-range type="range" min="0" max="100" value="55" class="range mt-1" />
          <div class="flex justify-between text-xs text-muted">
            <span>{m.clear}</span>
            <span>{m.frosted}</span>
          </div>

          <p class="mt-4 text-[13px] font-semibold text-muted">{m.language}</p>
          <ul class="mt-2 grid grid-cols-2 gap-1">
            {
              (['en', 'id'] as const).map((l) => (
                <li>
                  <a
                    href={paths[l]}
                    hreflang={l}
                    lang={l}
                    aria-current={l === lang ? 'true' : undefined}
                    class="block rounded-lg px-3 py-1.5 text-center text-[13px] font-semibold text-muted transition-colors hover:text-ink aria-[current=true]:bg-soft aria-[current=true]:text-ink"
                  >
                    {l === 'en' ? 'English' : 'Indonesia'}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>
  </div>
</header>

<div data-float-nav class="sm:hidden">
  <div data-float-body>
  <div data-float-tools></div>
  <nav data-float-panel aria-label={t.nav.aria} class="glass">
    <ul data-float-list>
      {
        items.map((i) => {
          const active = i.key === current;
          return (
            <li>
              <a
                href={i.href}
                aria-label={i.label}
                aria-current={active ? 'page' : undefined}
                draggable="false"
                class:list={[
                  'flex items-center justify-center rounded-full font-semibold transition-colors duration-300',
                  active ? 'bg-inv text-invink' : 'hover:bg-soft',
                ]}
              >
                <span data-float-icon><Icon name={icons[i.key]} size={20} stroke={36} /></span>
                <span data-float-label>{i.label}</span>
              </a>
            </li>
          );
        })
      }
    </ul>
  </nav>
  </div>
  <button type="button" data-float-bubble aria-label={t.nav.menuOpen} tabindex="-1" class="glass">
    <span data-bubble-icon="left"><Icon name="chevron-left" size={18} /></span>
    <span data-bubble-icon="right"><Icon name="chevron-right" size={18} /></span>
  </button>
</div>

<style is:global>
  @property --hh { syntax: '<length>'; inherits: true; initial-value: 73px; }
  @media (max-width: 639.98px) {
    [data-float-nav] { position: fixed; top: 50%; right: 0.5rem; z-index: 40; transform: translateY(-50%); touch-action: none; }
    [data-float-panel] { border-radius: 9999px; padding: 0.3rem; }
    [data-float-body] {
      display: flex; flex-direction: column; align-items: flex-end; gap: 0.5rem;
      transition: transform 0.4s cubic-bezier(0.22, 1, 0.36, 1), opacity 0.3s ease;
    }
    [data-float-tools]:empty { display: none; }
    html[data-nav-pos='left'] [data-float-body] { align-items: flex-start; }
    html[data-nav-pos='left'] [data-float-tools] [data-settings-pop] { right: auto; left: 0; }
    /* Header kosong saat menu di samping: konten naik halus. */
    html { transition: --hh 0.4s cubic-bezier(0.22, 1, 0.36, 1); }
    [data-header-row] { height: var(--hh); padding-block: 0; overflow: visible; }
    html[data-nav-pos='right'], html[data-nav-pos='left'] { --hh: 16px; }
    [data-float-list] { display: flex; flex-direction: column; gap: 0.25rem; }
    [data-float-list] a { width: 2.75rem; height: 2.75rem; }
    html[data-nav-pos='right'] [data-float-panel], html[data-nav-pos='left'] [data-float-panel] { padding: 0; }
    [data-float-label] { display: none; }
    [data-float-bubble] {
      position: absolute; top: 50%; right: -0.5rem; display: grid; place-items: center;
      width: 1.75rem; height: 3.5rem; border-radius: 9999px 0 0 9999px; padding-left: 0.2rem;
      opacity: 0; pointer-events: none; transform: translate(100%, -50%);
      transition: transform 0.4s cubic-bezier(0.22, 1, 0.36, 1), opacity 0.3s ease;
    }
    [data-float-nav][data-min] [data-float-body] { transform: translateX(calc(100% + 1rem)); opacity: 0; pointer-events: none; }
    [data-float-nav][data-min] [data-float-bubble] { opacity: 1; pointer-events: auto; transform: translate(0, -50%); }
    [data-bubble-icon='right'] { display: none; }
    [data-float-nav][data-dragging] [data-float-body] { transition: none; }

    html[data-nav-pos='left'] [data-float-nav] { right: auto; left: 0.5rem; }
        html[data-nav-pos='left'] [data-float-bubble] { right: auto; left: -0.5rem; border-radius: 0 9999px 9999px 0; padding: 0 0.2rem 0 0; transform: translate(-100%, -50%); }
    html[data-nav-pos='left'] [data-float-nav][data-min] [data-float-body] { transform: translateX(calc(-100% - 1rem)); }
    html[data-nav-pos='left'] [data-float-nav][data-min] [data-float-bubble] { transform: translate(0, -50%); }
    html[data-nav-pos='left'] [data-bubble-icon='left'] { display: none; }
    html[data-nav-pos='left'] [data-bubble-icon='right'] { display: block; }

    html[data-nav-pos='top'] [data-float-nav] { position: fixed; top: 0.875rem; left: 0.875rem; right: calc(0.875rem + 2.75rem + 0.5rem); transform: none; }
    html[data-nav-pos='top'] [data-float-panel] { padding: 0.25rem; }
    html[data-nav-pos='top'] [data-float-body] { display: block; transform: none !important; opacity: 1 !important; pointer-events: auto !important; }
    html[data-nav-pos='top'] [data-float-list] { flex-direction: row; justify-content: space-between; gap: 0; }
    html[data-nav-pos='top'] [data-float-list] a { width: auto; height: auto; padding: 0.5rem 0.75rem; font-size: 13.5px; }
    html[data-nav-pos='top'] [data-float-icon] { display: none; }
    html[data-nav-pos='top'] [data-float-label] { display: inline; }
    html[data-nav-pos='top'] [data-float-bubble] { display: none; }
  }
  @media (min-width: 430px) and (max-width: 639.98px) {
    html[data-nav-pos='top'] [data-float-nav] { right: calc(0.875rem + 5.5rem + 1rem); }
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>('[data-rapi-header]');
  if (header) {
    const root = document.documentElement;
    const btn = header.querySelector<HTMLButtonElement>('[data-settings-btn]')!;
    const pop = header.querySelector<HTMLElement>('[data-settings-pop]')!;

    const setOpen = (open: boolean) => {
      btn.setAttribute('aria-expanded', String(open));
      if (open) {
        pop.hidden = false;
        pop.classList.remove('pop');
        void pop.offsetWidth;
        pop.classList.add('pop');
      } else {
        pop.hidden = true;
        pop.classList.remove('pop');
      }
    };
    btn.addEventListener('click', () => setOpen(pop.hidden));
    document.addEventListener('pointerdown', (e) => {
      const target = e.target as Node;
      if (!pop.hidden && !pop.contains(target) && !btn.contains(target)) setOpen(false);
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !pop.hidden) {
        setOpen(false);
        btn.focus();
      }
    });

    /* Tema: light | dark | auto, default light. Peralihan lewat View Transitions API. */
    const mq = matchMedia('(prefers-color-scheme: dark)');
    const stored = () => {
      const v = localStorage.getItem('theme');
      return v === 'dark' || v === 'auto' ? v : 'light';
    };
    const apply = (mode: string) => {
      const dark = mode === 'dark' || (mode === 'auto' && mq.matches);
      root.dataset.theme = dark ? 'dark' : 'light';
      // Popover berada di dalam header yang bisa bertema gelap; ikutkan tema situs.
      pop.dataset.theme = root.dataset.theme;
    };
    const opts = [...header.querySelectorAll<HTMLElement>('[data-theme-opt]')];
    const paint = () => opts.forEach((o) => o.setAttribute('aria-checked', String(o.dataset.themeOpt === stored())));
    const onMq = () => apply('auto');
    const syncListener = () => {
      mq.removeEventListener('change', onMq);
      if (stored() === 'auto') mq.addEventListener('change', onMq);
    };
    apply(stored());
    paint();
    syncListener();
    addEventListener('pageshow', () => {
      apply(stored());
      paint();
      syncListener();
    });
    opts.forEach((o) =>
      o.addEventListener('click', () => {
        const mode = o.dataset.themeOpt!;
        localStorage.setItem('theme', mode);
        paint();
        syncListener();
        const doc = document as Document & { startViewTransition?: (cb: () => void) => unknown };
        if (doc.startViewTransition) doc.startViewTransition(() => apply(mode));
        else apply(mode);
      }),
    );

    /* Menu mobile: seret ke atas / tepi kanan / tepi kiri (snap, tersimpan, default kanan); samping mengecil saat scroll. */
    const float = document.querySelector<HTMLElement>('[data-float-nav]');
    if (float) {
      const panel = float.querySelector<HTMLElement>('[data-float-panel]')!;
      const bubble = float.querySelector<HTMLButtonElement>('[data-float-bubble]')!;
      const body = float.querySelector<HTMLElement>('[data-float-body]')!;
      const tools = header.querySelector<HTMLElement>('[data-tools]')!;
      const toolsHome = tools.parentElement!;
      const toolsSlot = float.querySelector<HTMLElement>('[data-float-tools]')!;
      const mobile = matchMedia('(max-width: 639.98px)');
      /* Di samping (mobile): tombol tema ikut menu sebagai gelembung sendiri. */
      const placeTools = () => {
        const side = mobile.matches && root.dataset.navPos !== 'top';
        const target = side ? toolsSlot : toolsHome;
        if (tools.parentElement !== target) target.appendChild(tools);
      };
      const valid = (v: string | null) => (v === 'top' || v === 'left' ? v : 'right');
      root.dataset.navPos = valid(localStorage.getItem('nav-pos'));
      placeTools();
      mobile.addEventListener('change', placeTools);
      const setMin = (min: boolean) => {
        if (min && root.dataset.navPos !== 'top') float.setAttribute('data-min', '');
        else float.removeAttribute('data-min');
      };
      let lastY = scrollY;
      addEventListener(
        'scroll',
        () => {
          if (Math.abs(scrollY - lastY) > 6) setMin(true);
          lastY = scrollY;
        },
        { passive: true },
      );
      /* Jangan menutupi tombol panah kartu: mengecil bila bertabrakan. */
      const avoid = () => {
        if (!mobile.matches || root.dataset.navPos === 'top') return;
        const f = float.getBoundingClientRect();
        const hit = [...document.querySelectorAll('[data-nav-avoid]')].some((el) => {
          const r = el.getBoundingClientRect();
          return r.width && r.left < f.right && r.right > f.left && r.top < f.bottom && r.bottom > f.top;
        });
        if (hit) setMin(true);
      };
      avoid();
      addEventListener('resize', avoid);
      /* Ketuk di luar menu samping: mengecil (tanpa menghalangi klik). */
      document.addEventListener(
        'pointerdown',
        (e) => {
          if (!float.contains(e.target as Node)) setMin(true);
        },
        { capture: true, passive: true },
      );
      bubble.addEventListener('click', () => {
        lastY = scrollY;
        setMin(false);
      });

      let start: { x: number; y: number; id: number } | null = null;
      let dragged = false;
      body.addEventListener('pointerdown', (e) => {
        if (e.button !== 0) return;
        start = { x: e.clientX, y: e.clientY, id: e.pointerId };
        dragged = false;
      });
      addEventListener('pointermove', (e) => {
        if (!start || e.pointerId !== start.id) return;
        const dx = e.clientX - start.x;
        const dy = e.clientY - start.y;
        if (!dragged && Math.hypot(dx, dy) < 10) return;
        if (!dragged) {
          dragged = true;
          float.setAttribute('data-dragging', '');
        }
        body.style.translate = `${dx}px ${dy}px`;
      });
      const end = (e: PointerEvent) => {
        if (!start) return;
        start = null;
        if (!dragged) return;
        const pos = e.clientY < innerHeight * 0.25 ? 'top' : e.clientX < innerWidth / 2 ? 'left' : 'right';
        // FLIP: animasikan dari posisi/ukuran saat dilepas ke posisi snap (morph bar atas <-> menu samping).
        const from = body.getBoundingClientRect();
        body.style.translate = '';
        root.dataset.navPos = pos;
        placeTools();
        requestAnimationFrame(avoid);
        localStorage.setItem('nav-pos', pos);
        setMin(false);
        const to = body.getBoundingClientRect();
        float.removeAttribute('data-dragging');
        if (!matchMedia('(prefers-reduced-motion: reduce)').matches && to.width && to.height) {
          body.animate(
            [
              {
                transformOrigin: '0 0',
                transform: `translate(${from.left - to.left}px, ${from.top - to.top}px) scale(${from.width / to.width}, ${from.height / to.height})`,
                opacity: 0.6,
              },
              { transformOrigin: '0 0', transform: 'none', opacity: 1 },
            ],
            { duration: 420, easing: 'cubic-bezier(0.22, 1, 0.36, 1)' },
          );
        }
      };
      addEventListener('pointerup', end);
      addEventListener('pointercancel', end);
      body.addEventListener(
        'click',
        (e) => {
          if (dragged) {
            e.preventDefault();
            e.stopPropagation();
            dragged = false;
          }
        },
        true,
      );
    }

    /* Kaca: 0 sampai 100 -> --g */
    const range = header.querySelector<HTMLInputElement>('[data-glass-range]')!;
    const label = header.querySelector<HTMLElement>('[data-glass-label]')!;
    const saved = localStorage.getItem('glass-level');
    if (saved !== null) range.value = String(Math.min(100, Math.max(0, +saved)));
    label.textContent = `${range.value}%`;
    range.addEventListener('input', () => {
      root.style.setProperty('--g', String(+range.value / 100));
      localStorage.setItem('glass-level', range.value);
      label.textContent = `${range.value}%`;
    });

    /* Header sticky mengikuti tema zona yang ada di bawahnya (dark / light / auto = ikut tema situs). */
    const zones = [...document.querySelectorAll<HTMLElement>('[data-zone]')];
    if (zones.length) {
      let ticking = false;
      const update = () => {
        ticking = false;
        const y = header.getBoundingClientRect().top + header.offsetHeight / 2;
        const zone = zones.find((z) => {
          const r = z.getBoundingClientRect();
          return r.top <= y && r.bottom > y;
        });
        const theme = zone?.dataset.zone;
        if (theme === 'dark' || theme === 'light') header.dataset.theme = theme;
        else header.removeAttribute('data-theme');
      };
      const onScroll = () => {
        if (!ticking) {
          ticking = true;
          requestAnimationFrame(update);
        }
      };
      addEventListener('scroll', onScroll, { passive: true });
      addEventListener('resize', onScroll);
      update();
    }
  }
</script>
