---
import { copy } from '../../data/content';
import type { Lang } from '../../data/content';
import WorksWith from './WorksWith.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = copy[lang];
---

<section id="about" aria-labelledby="about-h" class="grid scroll-mt-20 gap-3 lg:grid-cols-12">
  <div class="glass rounded-[28px] p-6 sm:p-8 lg:col-span-7">
    <h2 id="about-h" class="font-display text-[1.7rem] font-extrabold tracking-[-0.02em] sm:text-[2.1rem]">{t.about.title}</h2>
    <div class="mt-4 flex max-w-[62ch] flex-col gap-4 text-[17px] leading-relaxed">
      {t.about.body.map((p) => <p>{p}</p>)}
    </div>
  </div>

  <div class="glass rounded-[28px] p-6 sm:p-8 lg:col-span-5">
    <h2 class="font-display text-xl font-bold">{t.about.doTitle}</h2>
    <ul class="mt-4 flex flex-col gap-4">
      {
        t.about.does.map((d) => (
          <li>
            <p class="font-semibold">{d.title}</p>
            <p class="text-[15px] text-muted">{d.text}</p>
          </li>
        ))
      }
    </ul>
  </div>

  <div id="stack" class="glass scroll-mt-20 rounded-[28px] p-6 sm:p-8 lg:col-span-12">
    <h2 class="font-display text-xl font-bold">{t.stack.title}</h2>
    <div class="mt-4">
      <WorksWith lang={lang} />
    </div>
  </div>
</section>
