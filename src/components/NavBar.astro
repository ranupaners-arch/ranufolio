---
import { copy, routes } from '../data/content';
import type { Lang } from '../data/content';

interface Props {
  lang: Lang;
  /** Alamat halaman yang sama dalam bahasa lain. */
  altHref: string;
}
const { lang, altHref } = Astro.props;
const t = copy[lang];
const home = routes.home[lang];
const other = lang === 'id' ? 'en' : 'id';
const items = [
  { id: 'proyek', label: t.nav.projects },
  { id: 'tentang', label: t.nav.about },
  { id: 'stack', label: t.nav.stack },
  { id: 'kontak', label: t.nav.contact },
];
---

<header class="pointer-events-none fixed inset-x-0 top-0 z-40">
  <div class="mx-auto flex max-w-[1240px] items-center justify-between gap-2 px-4 pt-3 md:px-10">
    <a
      href={home}
      aria-label={t.nav.homeAria}
      class="pointer-events-auto hidden min-h-11 items-center rounded-full bg-white px-5 font-semibold tracking-tight text-ink shadow-sm ring-1 ring-black/10 sm:inline-flex"
    >
      Ranupane
    </a>

    <nav aria-label={t.nav.aria} class="pointer-events-auto">
      <ul class="flex items-center gap-0.5 rounded-full bg-white p-1 text-sm text-ink shadow-sm ring-1 ring-black/10">
        {
          items.map((i) => (
            <li>
              <a
                href={`${home}#${i.id}`}
                data-spy={i.id}
                class="inline-flex min-h-11 items-center rounded-full px-2.5 font-medium transition-colors hover:bg-ink/5 data-[active=true]:bg-ink data-[active=true]:text-white sm:px-4"
              >
                {i.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <a
      href={altHref}
      hreflang={other}
      lang={other}
      aria-label={t.nav.switchAria}
      class="pointer-events-auto grid size-[52px] place-items-center rounded-full bg-white text-sm font-semibold text-ink shadow-sm ring-1 ring-black/10 transition-colors hover:bg-sun"
    >
      {t.nav.switchLabel}
    </a>
  </div>
</header>

<script>
  // Tandai menu yang sedang dibaca (hanya berlaku di beranda, tempat section-nya ada).
  const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-spy]'));
  const targets = links
    .map((link) => ({ link, el: document.getElementById(link.dataset.spy!) }))
    .filter((x): x is { link: HTMLAnchorElement; el: HTMLElement } => x.el !== null);

  if (targets.length && 'IntersectionObserver' in window) {
    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          for (const { link, el } of targets) {
            const on = el === entry.target;
            link.dataset.active = String(on);
            if (on) link.setAttribute('aria-current', 'location');
            else link.removeAttribute('aria-current');
          }
        }
      },
      { rootMargin: '-45% 0px -50% 0px' },
    );
    targets.forEach(({ el }) => io.observe(el));
  }
</script>
