---
import { contact, copy } from '../data/content';
import type { Lang } from '../data/content';
import Arrow from './Arrow.astro';
import { getIcon } from '../lib/icons';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = copy[lang];
const f = t.contact.form;
const waHref = `https://wa.me/${contact.whatsapp}?text=${encodeURIComponent(t.contact.waText)}`;
const waIcon = getIcon(['siWhatsapp']);
const endpoint = import.meta.env.PUBLIC_FORM_ENDPOINT as string | undefined;
const accessKey = import.meta.env.PUBLIC_FORM_ACCESS_KEY as string | undefined;

const fieldClass =
  'mt-2 block min-h-12 w-full rounded-xl bg-ink px-4 py-3 text-base text-white ring-1 ring-white/20 placeholder:text-white/50 focus:ring-2 focus:ring-sun focus:outline-none';
---

<section id="kontak" class="dark-zone scroll-mt-4 bg-ink text-white">
  <div class="mx-auto max-w-[1240px] px-4 pb-4 pt-4 md:px-10 md:pb-6">
    <div class="grid gap-10 rounded-3xl bg-ink-2 p-6 ring-1 ring-white/10 md:p-12 lg:grid-cols-2 lg:gap-16">
      <div>
        <h2 class="display text-4xl md:text-6xl">{t.contact.title}</h2>
        <p class="mt-5 max-w-[42ch] text-lg leading-relaxed text-mute-dark">{t.contact.lead}</p>

        <div class="mt-8 flex flex-col gap-3 sm:flex-row">
          <a
            href={waHref}
            class="inline-flex min-h-12 w-full items-center justify-center gap-2 rounded-full bg-sun px-6 font-semibold text-ink transition-transform hover:-translate-y-0.5 sm:w-auto sm:min-w-[210px]"
          >
            {
              waIcon && (
                <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true">
                  <path d={waIcon.path} />
                </svg>
              )
            }
            {t.contact.whatsapp}
          </a>
          <a
            href="#form"
            class="inline-flex min-h-12 w-full items-center justify-center gap-2 rounded-full px-6 font-semibold ring-1 ring-white/40 transition-colors hover:bg-white/10 sm:w-auto sm:min-w-[210px]"
          >
            {t.contact.formLink}
            <Arrow dir="right" size={18} />
          </a>
        </div>

        <ul class="mt-6 text-[16px] text-mute-dark">
          <li>
            <a
              href={`https://wa.me/${contact.whatsapp}`}
              class="inline-flex min-h-11 items-center underline decoration-white/30 underline-offset-4 hover:text-white hover:decoration-white"
            >
              {contact.whatsappLabel}
            </a>
          </li>
          <li>
            <a
              href={`mailto:${contact.email}`}
              class="inline-flex min-h-11 items-center underline decoration-white/30 underline-offset-4 hover:text-white hover:decoration-white"
            >
              {contact.email}
            </a>
          </li>
        </ul>
      </div>

      <form
        id="form"
        data-contact-form
        data-endpoint={endpoint}
        data-email={contact.email}
        data-subject={f.subject}
        data-sending={f.sending}
        data-sent={f.sent}
        data-error={f.error}
        data-fallback={f.fallback}
        class="scroll-mt-24"
        novalidate
      >
        {accessKey && <input type="hidden" name="access_key" value={accessKey} />}
        <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" aria-hidden="true" class="hidden" />

        <label class="block font-medium">
          {f.name}
          <input type="text" name="name" required autocomplete="name" class={fieldClass} />
        </label>
        <label class="mt-5 block font-medium">
          {f.email}
          <input type="email" name="email" required autocomplete="email" inputmode="email" class={fieldClass} />
        </label>
        <label class="mt-5 block font-medium">
          {f.message}
          <textarea
            name="message"
            required
            rows="5"
            placeholder={f.messagePlaceholder}
            class:list={[fieldClass, 'resize-y']}
          ></textarea>
        </label>

        <button
          type="submit"
          class="mt-6 inline-flex min-h-12 w-full items-center justify-center rounded-full bg-white px-6 font-semibold text-ink transition-transform hover:-translate-y-0.5 disabled:opacity-60"
        >
          {f.send}
        </button>
        <p role="status" aria-live="polite" data-status class="mt-4 min-h-6 text-[15px] text-mute-dark"></p>
      </form>
    </div>
  </div>
</section>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-contact-form]');
  if (form) {
    const status = form.querySelector<HTMLElement>('[data-status]')!;
    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!form.reportValidity()) return;

      const data = new FormData(form);
      if (data.get('_gotcha')) return; // jebakan bot

      const endpoint = form.dataset.endpoint;
      if (endpoint) {
        button.disabled = true;
        status.textContent = form.dataset.sending ?? '';
        try {
          const res = await fetch(endpoint, { method: 'POST', body: data, headers: { Accept: 'application/json' } });
          if (!res.ok) throw new Error(String(res.status));
          form.reset();
          status.textContent = form.dataset.sent ?? '';
        } catch {
          status.textContent = form.dataset.error ?? '';
        } finally {
          button.disabled = false;
        }
        return;
      }

      // Tanpa endpoint: buka aplikasi email dengan pesan yang sudah terisi.
      const subject = encodeURIComponent(form.dataset.subject ?? '');
      const body = encodeURIComponent(`${data.get('message')}\n\n${data.get('name')}\n${data.get('email')}`);
      status.textContent = form.dataset.fallback ?? '';
      window.location.href = `mailto:${form.dataset.email}?subject=${subject}&body=${body}`;
    });
  }
</script>
