---
import { contact, copy, person } from '../data/content';
import type { Lang } from '../data/content';
import { getIcon } from '../lib/icons';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = copy[lang];
const socials = contact.socials.map((s) => ({ ...s, svg: getIcon(s.icon) }));
---

<footer class="dark-zone bg-ink text-white">
  <div class="mx-auto max-w-[1240px] px-4 pb-10 pt-4 md:px-10">
    <div class="flex flex-col gap-6 rounded-3xl bg-ink-2 p-6 ring-1 ring-white/10 md:flex-row md:items-center md:justify-between md:p-8">
      <div class="text-[15px] text-mute-dark">
        <p>© 2026 {person.name}. {t.footer.made}</p>
        <a
          href={`mailto:${contact.email}`}
          class="mt-1 inline-flex min-h-11 items-center underline decoration-white/30 underline-offset-4 hover:text-white hover:decoration-white"
        >
          {contact.email}
        </a>
      </div>

      <ul class="flex gap-3" aria-label={t.footer.socials}>
        {
          socials.map((s) => (
            <li>
              <a
                href={s.url}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={`${s.label}: ${s.handle}`}
                class="grid size-11 place-items-center rounded-full bg-white/10 transition-colors hover:bg-white/20"
              >
                {s.svg ? (
                  <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true">
                    <path d={s.svg.path} />
                  </svg>
                ) : (
                  <span aria-hidden="true" class="text-sm font-bold">
                    {s.glyph}
                  </span>
                )}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</footer>
