---
import { contact, copy, person } from '../data/content';
import type { Lang } from '../data/content';
import Arrow from './Arrow.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = copy[lang];
const waHref = `https://wa.me/${contact.whatsapp}?text=${encodeURIComponent(t.contact.waText)}`;
const linkedin = contact.socials.find((s) => s.label === 'LinkedIn')!.url;
const github = contact.socials.find((s) => s.label === 'GitHub')!.url;
---

<section class="dark-zone bg-ink text-white">
  <div
    class="mx-auto grid max-w-[1240px] gap-8 px-4 pb-12 pt-24 md:px-10 lg:grid-cols-[1.15fr_0.85fr] lg:items-center lg:gap-16 lg:pb-20 lg:pt-28"
  >
    <div class="hero-rise">
      <!-- Mobile: foto kecil di samping nama, supaya headline dan CTA tetap di layar pertama -->
      <div class="flex items-center gap-4 lg:hidden">
        <img
          src="/ranupane.jpg"
          alt={t.hero.photoAlt}
          width="168"
          height="168"
          loading="lazy"
          class="size-[84px] shrink-0 rounded-2xl object-cover object-[50%_18%]"
        />
        <div>
          <p class="text-lg font-semibold leading-tight">{person.name}</p>
          <p class="mt-1 text-[15px] text-mute-dark">{t.hero.role}</p>
        </div>
      </div>

      <h1 class="display mt-7 text-[clamp(2.6rem,7.2vw,6rem)] lg:mt-0">{t.hero.title}</h1>
      <p class="mt-5 max-w-[46ch] text-lg leading-relaxed text-mute-dark">{t.hero.bio}</p>

      <p class="mt-5 inline-flex items-center gap-2.5 rounded-full bg-white/10 px-4 py-2 text-[15px]">
        <span class="size-2 shrink-0 rounded-full bg-sun" aria-hidden="true"></span>
        {t.hero.badge}
      </p>

      <!-- CTA bertingkat dalam bentuk tile -->
      <div class="mt-8 grid grid-cols-2 gap-3">
        <a
          href={waHref}
          class="group col-span-2 flex min-h-[140px] flex-col justify-between rounded-3xl bg-sun p-5 text-ink transition-transform hover:-translate-y-0.5"
        >
          <span class="flex items-start justify-between gap-3">
            <span class="text-[15px] font-medium text-ink/75">{t.hero.ownerQ}</span>
            <span class="grid size-10 place-items-center rounded-full bg-ink text-sun">
              <Arrow />
            </span>
          </span>
          <span class="display text-3xl md:text-4xl">{t.hero.ownerA}</span>
        </a>

        <a
          href={linkedin}
          target="_blank"
          rel="noopener noreferrer"
          class="group flex min-h-[132px] flex-col justify-between rounded-3xl bg-white/10 p-5 transition-colors hover:bg-white/15"
        >
          <span class="flex items-start justify-between gap-2">
            <span class="text-[15px] text-mute-dark">{t.hero.recruiterQ}</span>
            <span class="grid size-9 shrink-0 place-items-center rounded-full bg-white/15">
              <Arrow size={16} />
            </span>
          </span>
          <span class="text-xl font-semibold">{t.hero.recruiterA}</span>
        </a>

        <a
          href={github}
          target="_blank"
          rel="noopener noreferrer"
          class="group flex min-h-[132px] flex-col justify-between rounded-3xl bg-white/10 p-5 transition-colors hover:bg-white/15"
        >
          <span class="flex items-start justify-between gap-2">
            <span class="text-[15px] text-mute-dark">{t.hero.learnQ}</span>
            <span class="grid size-9 shrink-0 place-items-center rounded-full bg-white/15">
              <Arrow size={16} />
            </span>
          </span>
          <span class="text-xl font-semibold">{t.hero.learnA}</span>
        </a>
      </div>
    </div>

    <!-- Desktop: foto besar dengan sudut membulat; latar sudah gelap sehingga menyatu dengan hero -->
    <div class="hero-reveal hidden lg:block">
      <div class="aspect-[4/5] overflow-hidden rounded-[32px] bg-ink-2 ring-1 ring-white/10">
        <img
          src="/ranupane.jpg"
          alt={t.hero.photoAlt}
          width="1100"
          height="1467"
          loading="lazy"
          class="h-full w-full object-cover object-top"
        />
      </div>
    </div>
  </div>
</section>
